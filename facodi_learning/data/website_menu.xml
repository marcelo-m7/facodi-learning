<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Navigation is reconciled against the FACODI website-specific root.
        Do not declare generic/default website.menu records here: in
        multi-website databases Odoo can clone those records into unrelated
        websites. The model method is idempotent and owns the Explore tree.
    -->
    <function model="website.menu" name="facodi_reconcile_navigation"/>
</odoo>
