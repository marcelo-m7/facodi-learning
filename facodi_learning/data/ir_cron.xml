<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_process_facodi_learning_analysis_jobs" model="ir.cron">
        <field name="name">FACODI: Process learning analysis jobs</field>
        <field name="model_id" ref="model_facodi_learning_analysis_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_pending_jobs()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_verify_facodi_curriculum_sources" model="ir.cron">
        <field name="name">FACODI: Verify opted-in curriculum sources</field>
        <field name="model_id" ref="model_facodi_learning_curriculum_source"/>
        <field name="state">code</field>
        <field name="code">model._cron_verify_enabled_sources()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_discover_facodi_learning_courses" model="ir.cron">
        <field name="name">FACODI: Discover external courses</field>
        <field name="model_id" ref="model_facodi_learning_discovery_run"/>
        <field name="state">code</field>
        <field name="code">model._cron_discover_courses()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
