<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_facodi_submission_form_candidate_handoff" model="ir.ui.view">
        <field name="name">facodi.learning.submission.form.candidate.handoff</field>
        <field name="model">facodi.learning.submission</field>
        <field name="inherit_id" ref="facodi_learning.view_facodi_submission_form"/>
        <field name="arch" type="xml">
            <button name="action_accept" position="after">
                <button name="action_handoff_candidate"
                        type="object"
                        string="Route to Candidate Pipeline"
                        class="btn-primary"
                        invisible="state != 'accepted' or candidate_id or source_id"
                        groups="website_slides.group_website_slides_manager"/>
            </button>
        </field>
    </record>
</odoo>
