<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_facodi_discovery_run_search" model="ir.ui.view">
        <field name="name">facodi.learning.discovery.run.search</field>
        <field name="model">facodi.learning.discovery.run</field>
        <field name="arch" type="xml">
            <search string="FACODI Discovery Runs">
                <field name="provider"/>
                <field name="state"/>
                <field name="requested_by_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <group>
                    <filter name="group_provider" string="Provider" context="{'group_by': 'provider'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_facodi_discovery_run_list" model="ir.ui.view">
        <field name="name">facodi.learning.discovery.run.list</field>
        <field name="model">facodi.learning.discovery.run</field>
        <field name="arch" type="xml">
            <list string="FACODI Discovery Runs"
                  decoration-info="state == 'processing'"
                  decoration-success="state == 'completed'"
                  decoration-danger="state == 'failed'">
                <field name="provider"/>
                <field name="state"/>
                <field name="requested_by_id"/>
                <field name="started_at"/>
                <field name="completed_at"/>
                <field name="items_seen" optional="show"/>
                <field name="candidates_created" optional="show"/>
                <field name="candidates_refreshed" optional="show"/>
                <field name="candidates_ignored" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_facodi_discovery_run_form" model="ir.ui.view">
        <field name="name">facodi.learning.discovery.run.form</field>
        <field name="model">facodi.learning.discovery.run</field>
        <field name="arch" type="xml">
            <form string="FACODI Discovery Run">
                <header>
                    <button name="action_process"
                            type="object"
                            string="Run Discovery"
                            class="btn-primary"
                            groups="website_slides.group_website_slides_manager"
                            invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,processing,completed,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="provider" readonly="state != 'pending'"/>
                            <field name="requested_by_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="started_at" readonly="1"/>
                            <field name="completed_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Execution Summary">
                        <field name="items_seen" readonly="1"/>
                        <field name="candidates_created" readonly="1"/>
                        <field name="candidates_refreshed" readonly="1"/>
                        <field name="candidates_ignored" readonly="1"/>
                    </group>
                    <group string="Failure" invisible="not last_error">
                        <field name="last_error" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_facodi_discovery_runs" model="ir.actions.act_window">
        <field name="name">Discovery Runs</field>
        <field name="res_model">facodi.learning.discovery.run</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_facodi_discovery_run_search"/>
    </record>

    <menuitem id="menu_facodi_learning_discovery_runs"
              name="Discovery Runs"
              parent="menu_facodi_learning_course_discovery"
              action="action_facodi_discovery_runs"
              groups="website_slides.group_website_slides_officer"
              sequence="2"/>
</odoo>
