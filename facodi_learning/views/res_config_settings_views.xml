<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_facodi_learning" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.facodi.learning</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_slides.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='website_slides']/block[@id='website_slides_selection_settings']" position="inside">
                <setting id="facodi_learning_analysis_settings" string="FACODI Analysis" help="Configure the standard scheduled analysis pipeline for FACODI learning content.">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="facodi_learning_analysis_provider" class="col-lg-4 o_light_label"/>
                            <field name="facodi_learning_analysis_provider" class="oe_inline"/>
                        </div>
                        <div class="row mt16">
                            <label for="facodi_learning_analysis_batch_size" class="col-lg-4 o_light_label"/>
                            <field name="facodi_learning_analysis_batch_size" class="oe_inline"/>
                        </div>
                    </div>
                </setting>
                <setting id="facodi_learning_course_selection_settings" string="FACODI Course Selection" help="Configure deterministic course candidate review and Auto Approve guardrails.">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="facodi_learning_course_selection_mode" class="col-lg-4 o_light_label"/>
                            <field name="facodi_learning_course_selection_mode" class="oe_inline"/>
                        </div>
                        <div class="row mt16">
                            <label for="facodi_learning_course_selection_languages" class="col-lg-4 o_light_label"/>
                            <field name="facodi_learning_course_selection_languages" class="oe_inline"/>
                        </div>
                        <div class="row mt16">
                            <label for="facodi_learning_auto_approve_trusted_providers" class="col-lg-4 o_light_label"/>
                            <field name="facodi_learning_auto_approve_trusted_providers" class="oe_inline"/>
                        </div>
                        <div invisible="facodi_learning_course_selection_mode == 'manual'">
                            <div class="row mt16">
                                <label for="facodi_learning_auto_approve_min_relevance" class="col-lg-4 o_light_label"/>
                                <field name="facodi_learning_auto_approve_min_relevance" class="oe_inline"/>
                            </div>
                            <div class="row mt16">
                                <label for="facodi_learning_auto_approve_min_metadata_quality" class="col-lg-4 o_light_label"/>
                                <field name="facodi_learning_auto_approve_min_metadata_quality" class="oe_inline"/>
                            </div>
                            <div class="row mt16">
                                <label for="facodi_learning_auto_approve_min_language_fit" class="col-lg-4 o_light_label"/>
                                <field name="facodi_learning_auto_approve_min_language_fit" class="oe_inline"/>
                            </div>
                            <div class="row mt16">
                                <label for="facodi_learning_auto_approve_min_coverage" class="col-lg-4 o_light_label"/>
                                <field name="facodi_learning_auto_approve_min_coverage" class="oe_inline"/>
                            </div>
                            <div class="row mt16">
                                <label for="facodi_learning_auto_approve_max_duplication_risk" class="col-lg-4 o_light_label"/>
                                <field name="facodi_learning_auto_approve_max_duplication_risk" class="oe_inline"/>
                            </div>
                        </div>
                    </div>
                </setting>
                <setting id="facodi_learning_course_mapping_settings" string="FACODI Course Mapping" help="Configure deterministic course relation review independently from course selection. Prerequisites always require Manager review.">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="facodi_learning_course_mapping_mode" class="col-lg-4 o_light_label"/>
                            <field name="facodi_learning_course_mapping_mode" class="oe_inline"/>
                        </div>
                        <div invisible="facodi_learning_course_mapping_mode != 'auto'">
                            <div class="row mt16">
                                <label for="facodi_learning_course_mapping_auto_types" class="col-lg-4 o_light_label"/>
                                <field name="facodi_learning_course_mapping_auto_types" class="oe_inline"/>
                            </div>
                            <div class="row mt16">
                                <label for="facodi_learning_course_mapping_min_confidence" class="col-lg-4 o_light_label"/>
                                <field name="facodi_learning_course_mapping_min_confidence" class="oe_inline"/>
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
