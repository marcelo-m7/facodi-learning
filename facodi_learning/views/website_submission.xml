<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="resource_submission_form" name="FACODI Resource Submission">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-8 col-xl-7">
                            <p class="text-uppercase small fw-semibold mb-2">Contribute to FACODI</p>
                            <h1>Suggest a learning resource</h1>
                            <p class="lead">
                                Share a public learning resource for editorial review. A submission is a suggestion only:
                                FACODI will check relevance, provenance and publication rights before it can become learning content.
                            </p>

                            <div t-if="curriculum_unit" class="alert alert-info" role="status">
                                <span class="d-block small text-uppercase fw-semibold">Suggested for curricular unit</span>
                                <strong>
                                    <t t-esc="curriculum_unit.external_unit_code"/> ·
                                    <t t-esc="curriculum_unit.name"/>
                                </strong>
                                <a t-att-href="curriculum_unit._facodi_public_path()"
                                   class="d-block mt-1">
                                    View curricular unit
                                </a>
                            </div>

                            <div t-if="duplicate" class="alert alert-warning" role="status">
                                This resource is already under editorial review for this context. You can suggest another resource instead.
                            </div>

                            <div t-if="errors" class="alert alert-danger" role="alert">
                                <p class="fw-semibold mb-2">Check the information below.</p>
                                <ul class="mb-0">
                                    <li t-foreach="errors" t-as="error"><t t-esc="error"/></li>
                                </ul>
                            </div>

                            <form action="/contribuir/recurso"
                                  method="post"
                                  class="mt-4"
                                  data-facodi-resource-submission="1"
                                  data-metadata-endpoint="/contribuir/recurso/metadata">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="d-none"
                                     aria-hidden="true"
                                     data-facodi-discovery-messages="1">
                                    <span data-facodi-message="discovering">Detecting title and language…</span>
                                    <span data-facodi-message="detected">FACODI detected this YouTube resource.</span>
                                    <span data-facodi-message="unavailable">Could not detect details automatically. You can continue manually.</span>
                                    <span data-facodi-message="unsupported">Automatic discovery is currently available for public YouTube videos. You can continue manually.</span>
                                </div>
                                <input t-if="curriculum_unit"
                                       type="hidden"
                                       name="curriculum_unit_id"
                                       t-att-value="curriculum_unit.id"/>

                                <div class="mb-3">
                                    <label class="form-label" for="facodi_submission_name">Resource title</label>
                                    <input id="facodi_submission_name"
                                           name="name"
                                           type="text"
                                           maxlength="200"
                                           class="form-control"
                                           t-att-value="form_values.get('name', '')"
                                           placeholder="Example: Introduction to Operating Systems"/>
                                    <div class="form-text">
                                        For supported YouTube links, FACODI can fill the title and language automatically. Review the detected details before submitting.
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label" for="facodi_submission_url">Public resource URL</label>
                                    <input id="facodi_submission_url"
                                           name="source_url"
                                           type="url"
                                           required="required"
                                           maxlength="2048"
                                           class="form-control"
                                           t-att-value="form_values.get('source_url', '')"
                                           placeholder="https://..."/>
                                    <div class="form-text">
                                        Use the canonical public HTTP or HTTPS page. Do not upload passwords, private links or credentials.
                                        Public YouTube submissions may appear immediately in the Community videos section before editorial review.
                                        FACODI does not publish your account identity, private tracking token or review notes there.
                                    </div>
                                    <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                data-facodi-discover-button="1">
                                            Detect details
                                        </button>
                                        <span class="small text-muted"
                                              data-facodi-discovery-status="1"
                                              aria-live="polite"></span>
                                    </div>
                                    <div class="card mt-3 d-none"
                                         data-facodi-metadata-preview="1"
                                         aria-live="polite">
                                        <div class="card-body">
                                            <div class="d-flex gap-3 align-items-start">
                                                <img class="rounded d-none"
                                                     data-facodi-metadata-thumbnail="1"
                                                     alt=""
                                                     width="144"
                                                     height="81"
                                                     loading="lazy"/>
                                                <div class="min-w-0">
                                                    <div class="small text-uppercase fw-semibold text-muted mb-1">Detected resource</div>
                                                    <div class="fw-semibold"
                                                         data-facodi-metadata-title="1"></div>
                                                    <div class="small text-muted"
                                                         data-facodi-metadata-author="1"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label" for="facodi_submission_language">Language</label>
                                    <select id="facodi_submission_language" name="language" class="form-select">
                                        <option value="" t-att-selected="not form_values.get('language')">Not specified</option>
                                        <option value="pt" t-att-selected="form_values.get('language') == 'pt'">Portuguese</option>
                                        <option value="en" t-att-selected="form_values.get('language') == 'en'">English</option>
                                        <option value="es" t-att-selected="form_values.get('language') == 'es'">Spanish</option>
                                        <option value="fr" t-att-selected="form_values.get('language') == 'fr'">French</option>
                                    </select>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label" for="facodi_submission_context">Why could this resource be useful?</label>
                                    <textarea id="facodi_submission_context"
                                              name="context"
                                              rows="5"
                                              maxlength="4000"
                                              class="form-control"
                                              placeholder="Optional: topic, curricular unit, course or learning goal."><t t-esc="form_values.get('context', '')"/></textarea>
                                </div>

                                <button type="submit" class="btn btn-primary">Submit for review</button>
                                <a t-if="not request.env.user._is_public()"
                                   href="/minhas-contribuicoes"
                                   class="btn btn-outline-secondary">My submissions</a>
                                <a href="/contactus" class="btn btn-link">Other contribution</a>
                            </form>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="resource_submission_status" name="FACODI Resource Submission Status">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-8 col-xl-7">
                            <p class="text-uppercase small fw-semibold mb-2">Resource suggestion</p>
                            <h1>Submission received</h1>
                            <p class="lead" t-esc="submission.name"/>

                            <div class="card my-4">
                                <div class="card-body">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-4">Status</dt>
                                        <dd class="col-sm-8">
                                            <span class="badge text-bg-secondary" t-esc="state_label"/>
                                        </dd>
                                        <dt class="col-sm-4">Resource</dt>
                                        <dd t-attf-class="col-sm-8 #{'mb-2' if curriculum_unit else 'mb-0'}">
                                            <a t-att-href="submission.source_url"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               t-esc="submission.source_url"/>
                                        </dd>
                                        <t t-if="curriculum_unit">
                                            <dt class="col-sm-4">Suggested for</dt>
                                            <dd class="col-sm-8 mb-0">
                                                <a t-att-href="curriculum_unit_url"
                                                   t-esc="curriculum_unit.name"/>
                                            </dd>
                                        </t>
                                    </dl>
                                </div>
                            </div>

                            <div t-if="submission.state == 'submitted'" class="alert alert-info">
                                Waiting for editorial review.
                            </div>
                            <div t-elif="submission.state == 'reviewing'" class="alert alert-info">
                                FACODI is checking relevance, provenance and publication rights.
                            </div>
                            <div t-elif="submission.state == 'accepted'" class="alert alert-success">
                                Accepted for curation. This does not mean the resource is published yet.
                            </div>
                            <div t-elif="submission.state == 'rejected'" class="alert alert-secondary">
                                This suggestion will not proceed in its current form.
                            </div>
                            <div t-elif="submission.state == 'resolved'" class="alert alert-success">
                                The suggestion has been routed into the canonical FACODI content workflow.
                            </div>
                            <div t-elif="submission.state == 'withdrawn'" class="alert alert-secondary">
                                You withdrew this submission. It is retained only as audit history and is no longer shown in the public community queue.
                            </div>

                            <p class="text-muted small">
                                Keep this private status link if you want to check the editorial state later.
                            </p>
                            <div class="d-flex flex-wrap gap-2">
                                <a t-if="curriculum_unit"
                                   t-att-href="curriculum_unit_url"
                                   class="btn btn-primary">
                                    Back to curricular unit
                                </a>
                                <a href="/slides" class="btn btn-outline-primary">Explore learning content</a>
                                <a href="/explorar/videos" class="btn btn-outline-secondary">Community videos</a>
                                <a t-if="not request.env.user._is_public() and submission.submitted_by_id == request.env.user"
                                   t-att-href="'/minhas-contribuicoes/%s' % submission.id"
                                   class="btn btn-outline-secondary">Manage submission</a>
                                <a t-if="curriculum_unit"
                                   t-att-href="'/contribuir/recurso?curriculum_unit_id=%s' % curriculum_unit.id"
                                   class="btn btn-link">Suggest a resource</a>
                                <a t-else="" href="/contribuir/recurso" class="btn btn-link">Suggest a resource</a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
    <template id="resource_submission_my_list" name="FACODI My Resource Submissions">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5" data-facodi-my-submissions="1">
                    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
                        <div>
                            <p class="text-uppercase small fw-semibold text-muted mb-2">Your FACODI contributions</p>
                            <h1 class="h2 mb-1">My submissions</h1>
                            <p class="text-muted mb-0">Track, edit or withdraw resources submitted while signed in.</p>
                        </div>
                        <a href="/contribuir/recurso" class="btn btn-primary">Submit another resource</a>
                    </div>

                    <div class="facodi-contribution-dashboard" aria-label="Contribution summary">
                        <div class="facodi-contribution-stat"><span>Total</span><strong t-esc="state_counts['total']"/></div>
                        <div class="facodi-contribution-stat"><span>In review</span><strong t-esc="state_counts['active']"/></div>
                        <div class="facodi-contribution-stat"><span>Accepted / routed</span><strong t-esc="state_counts['accepted']"/></div>
                        <div class="facodi-contribution-stat"><span>Closed</span><strong t-esc="state_counts['closed']"/></div>
                    </div>

                    <div t-if="rows" class="row g-3">
                        <div t-foreach="rows" t-as="row" class="col-12">
                            <article class="card" data-facodi-submission-card="1"
                                     t-att-data-facodi-state="row['submission'].state">
                                <div class="card-body">
                                    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
                                        <div class="min-w-0">
                                            <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                                                <span class="facodi-submission-index">Submission #<t t-esc="row['submission'].id"/></span>
                                                <span class="badge text-bg-light border" t-esc="row['state_label']"/>
                                                <span t-if="row['submission'].language"
                                                      class="small text-muted"
                                                      t-esc="row['submission'].language"/>
                                            </div>
                                            <h2 class="h5 mb-2" t-esc="row['submission'].name"/>
                                            <a t-att-href="row['submission'].source_url"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="small text-break"
                                               t-esc="row['submission'].source_url"/>
                                        </div>
                                        <div class="d-flex flex-wrap gap-2 align-items-start">
                                            <a t-att-href="'/minhas-contribuicoes/%s' % row['submission'].id"
                                               class="btn btn-outline-primary">Manage</a>
                                            <span t-if="row['can_edit']" class="badge text-bg-info align-self-center">Editable</span>
                                            <span t-elif="row['can_withdraw']" class="badge text-bg-warning align-self-center">Withdrawal available</span>
                                        </div>
                                    </div>
                                </div>
                            </article>
                        </div>
                    </div>
                    <div t-else="" class="facodi-empty-state" data-facodi-empty-state="1">
                        <span class="facodi-empty-icon fa fa-paper-plane-o" aria-hidden="true"></span>
                        <h2 class="h4">Your contribution desk is ready</h2>
                        <p class="text-muted">You have no account-linked submissions yet. Anonymous submissions remain accessible only through their private tracking link.</p>
                        <a href="/contribuir/recurso" class="btn btn-primary">Share your first resource</a>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="resource_submission_manage" name="FACODI Manage Resource Submission">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5" data-facodi-manage-submission="1">
                    <div class="row justify-content-center">
                        <div class="col-lg-9 col-xl-8">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                                <div>
                                    <p class="text-uppercase small fw-semibold text-muted mb-2">Your contribution</p>
                                    <h1 class="h2 mb-2" t-esc="submission.name"/>
                                    <span class="badge text-bg-light border" t-esc="state_label"/>
                                </div>
                                <a href="/minhas-contribuicoes" class="btn btn-outline-secondary">Back to my submissions</a>
                            </div>

                            <div t-if="errors" class="alert alert-danger" role="alert">
                                <ul class="mb-0">
                                    <li t-foreach="errors" t-as="error"><t t-esc="error"/></li>
                                </ul>
                            </div>

                            <div t-if="can_edit" class="alert alert-info">
                                You can edit this submission until FACODI starts editorial review. Changes are reflected in the public Community videos queue when applicable.
                            </div>
                            <div t-elif="submission.state == 'reviewing'" class="alert alert-warning">
                                Editorial review has started, so the submitted details are locked. You can still withdraw the submission.
                            </div>
                            <div t-elif="submission.state in ('accepted', 'resolved')" class="alert alert-success">
                                This submission has progressed into FACODI curation. Its original contribution record is now preserved as audit history.
                            </div>
                            <div t-elif="submission.state == 'rejected'" class="alert alert-secondary">
                                This submission was not accepted in its current form.
                            </div>
                            <div t-elif="submission.state == 'withdrawn'" class="alert alert-secondary">
                                You withdrew this submission. It is no longer displayed in the public Community videos queue.
                            </div>

                            <form t-if="can_edit"
                                  t-att-action="'/minhas-contribuicoes/%s/editar' % submission.id"
                                  method="post"
                                  class="card card-body mb-4">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="mb-3">
                                    <label class="form-label" for="facodi_manage_name">Title</label>
                                    <input id="facodi_manage_name"
                                           type="text"
                                           name="name"
                                           maxlength="200"
                                           required="required"
                                           class="form-control"
                                           t-att-value="(form_values or {}).get('name', submission.name)"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="facodi_manage_url">Public resource URL</label>
                                    <input id="facodi_manage_url"
                                           type="url"
                                           name="source_url"
                                           maxlength="2048"
                                           required="required"
                                           class="form-control"
                                           t-att-value="(form_values or {}).get('source_url', submission.source_url)"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="facodi_manage_language">Language</label>
                                    <select id="facodi_manage_language" name="language" class="form-select">
                                        <t t-set="current_language" t-value="(form_values or {}).get('language', submission.language or '')"/>
                                        <option value="" t-att-selected="not current_language">Not specified</option>
                                        <option value="pt" t-att-selected="current_language == 'pt'">Portuguese</option>
                                        <option value="en" t-att-selected="current_language == 'en'">English</option>
                                        <option value="es" t-att-selected="current_language == 'es'">Spanish</option>
                                        <option value="fr" t-att-selected="current_language == 'fr'">French</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="facodi_manage_context">Contribution context</label>
                                    <textarea id="facodi_manage_context"
                                              name="context"
                                              rows="5"
                                              maxlength="4000"
                                              class="form-control"><t t-esc="(form_values or {}).get('context', submission.context or '')"/></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary align-self-start">Save changes</button>
                            </form>

                            <div t-if="not can_edit" class="card card-body mb-4">
                                <dl class="row mb-0">
                                    <dt class="col-sm-3">Resource</dt>
                                    <dd class="col-sm-9"><a t-att-href="submission.source_url" target="_blank" rel="noopener noreferrer" t-esc="submission.source_url"/></dd>
                                    <dt class="col-sm-3">Language</dt>
                                    <dd class="col-sm-9" t-esc="submission.language or 'Not specified'"/>
                                    <dt class="col-sm-3">Context</dt>
                                    <dd class="col-sm-9 mb-0" t-esc="submission.context or 'No additional context.'"/>
                                </dl>
                            </div>

                            <form t-if="can_withdraw"
                                  t-att-action="'/minhas-contribuicoes/%s/retirar' % submission.id"
                                  method="post"
                                  class="border rounded p-3">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <p class="mb-2"><strong>Withdraw this submission?</strong></p>
                                <p class="text-muted small">
                                    Withdrawal removes the item from the public Community videos queue and prevents it from continuing through the contribution workflow. The record is retained as audit history.
                                </p>
                                <button type="submit" class="btn btn-outline-danger">Withdraw submission</button>
                            </form>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>


    <template id="my_facodi_dashboard" name="Minha FACODI dashboard">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5" data-facodi-user-dashboard="1">
                    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
                        <div>
                            <p class="text-uppercase small fw-semibold text-muted mb-2">Minha FACODI</p>
                            <h1 class="display-6 fw-bold mb-2">Your campus, your tabs.</h1>
                            <p class="lead text-muted mb-0">Pick up where you left off, drop something useful for the community and keep your learning momentum visible.</p>
                        </div>
                        <a href="/explorar" class="btn btn-primary">Explore learning</a>
                    </div>

                    <div class="facodi-momentum-strip mb-4" aria-label="Learning momentum">
                        <div class="facodi-momentum-card facodi-highlight-lime">
                            <span class="facodi-momentum-card__value" t-esc="learning_stats['courses']"/>
                            <span class="facodi-momentum-card__label">courses on your desk</span>
                        </div>
                        <div class="facodi-momentum-card facodi-highlight-mint">
                            <span class="facodi-momentum-card__value" t-esc="learning_stats['completed']"/>
                            <span class="facodi-momentum-card__label">courses completed</span>
                        </div>
                        <div class="facodi-momentum-card facodi-highlight-cyan">
                            <span class="facodi-momentum-card__value" t-esc="learning_stats['contributions']"/>
                            <span class="facodi-momentum-card__label">community drops</span>
                        </div>
                        <div class="facodi-momentum-card facodi-highlight-pink">
                            <span class="facodi-momentum-card__value" t-esc="learning_stats['in_review']"/>
                            <span class="facodi-momentum-card__label">on the review desk</span>
                        </div>
                    </div>

                    <div class="facodi-dashboard-grid mb-5">
                        <a href="/slides" class="facodi-dashboard-action text-decoration-none">
                            <span class="facodi-dashboard-action__icon fa fa-graduation-cap" aria-hidden="true"></span>
                            <div><strong>My learning</strong><small>Courses and learning progress</small></div>
                        </a>
                        <a href="/minhas-contribuicoes" class="facodi-dashboard-action text-decoration-none">
                            <span class="facodi-dashboard-action__icon fa fa-paper-plane" aria-hidden="true"></span>
                            <div><strong>My contributions</strong><small><t t-esc="submission_count"/> shared · <t t-esc="active_submission_count"/> in review</small></div>
                        </a>
                        <a href="/contribuir/recurso" class="facodi-dashboard-action text-decoration-none">
                            <span class="facodi-dashboard-action__icon fa fa-plus" aria-hidden="true"></span>
                            <div><strong>Share a resource</strong><small>Add a useful open learning source</small></div>
                        </a>
                        <a href="/forum" class="facodi-dashboard-action text-decoration-none">
                            <span class="facodi-dashboard-action__icon fa fa-comments" aria-hidden="true"></span>
                            <div><strong>Community</strong><small>Discuss, ask and help other learners</small></div>
                        </a>
                    </div>

                    <div class="row g-4">
                        <div class="col-12 col-xl-7">
                            <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                                <div>
                                    <p class="facodi-kicker mb-1">Continue</p>
                                    <h2 class="h3 mb-0">Your courses</h2>
                                </div>
                                <a href="/slides" class="btn btn-sm btn-outline-secondary">All courses</a>
                            </div>
                            <div t-if="enrolled_courses" class="row g-3">
                                <div t-foreach="enrolled_courses" t-as="course" class="col-12 col-md-6">
                                    <article class="card h-100 o_wslides_course_card">
                                        <div class="card-body d-flex flex-column">
                                            <div class="small text-uppercase fw-semibold text-muted mb-2">Course</div>
                                            <h3 class="h5 card-title"><span t-field="course.name"/></h3>
                                            <p t-if="course.description_short" class="small text-muted flex-grow-1"><t t-esc="course.description_short"/></p>
                                            <a t-att-href="course.website_url" class="stretched-link">Continue course</a>
                                        </div>
                                    </article>
                                </div>
                            </div>
                            <div t-else="" class="facodi-empty-state" data-facodi-empty-state="1">
                                <span class="facodi-empty-icon fa fa-compass" aria-hidden="true"></span>
                                <h3 class="h4">Build your learning shelf</h3>
                                <p class="text-muted">You are not enrolled in a published FACODI course yet. Browse the catalogue and choose where to start.</p>
                                <a href="/slides" class="btn btn-primary">Browse courses</a>
                            </div>
                        </div>

                        <div class="col-12 col-xl-5">
                            <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                                <div>
                                    <p class="facodi-kicker mb-1">Community</p>
                                    <h2 class="h3 mb-0">Recent contributions</h2>
                                </div>
                                <a href="/minhas-contribuicoes" class="btn btn-sm btn-outline-secondary">View all</a>
                            </div>
                            <div t-if="submission_rows" class="d-grid gap-2">
                                <a t-foreach="submission_rows" t-as="row"
                                   t-att-href="'/minhas-contribuicoes/%s' % row['submission'].id"
                                   class="facodi-dashboard-submission text-decoration-none">
                                    <span class="facodi-dashboard-submission__state" t-esc="row['state_label']"/>
                                    <strong t-esc="row['submission'].name"/>
                                    <small t-esc="row['submission'].language or '—'"/>
                                </a>
                            </div>
                            <div t-else="" class="facodi-empty-state" data-facodi-empty-state="1">
                                <span class="facodi-empty-icon fa fa-lightbulb-o" aria-hidden="true"></span>
                                <h3 class="h4">Share something useful</h3>
                                <p class="text-muted">Found a strong open video, article or document? Put it on the community review desk.</p>
                                <a href="/contribuir/recurso" class="btn btn-primary">Share a resource</a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

</odoo>
