<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="approved_learning_resources" inherit_id="website_slides.slide_main" name="Reviewed learning resources">
        <xpath expr="//t[@t-call='website_slides.slide_content_detailed']" position="after">
            <t t-set="learning_resources" t-value="slide._facodi_related_slides(website)"/>
            <aside t-if="learning_resources" class="mt-4 border-top pt-3" aria-label="Learning resources">
                <h2 class="h5">Explore further</h2>
                <ul class="list-unstyled">
                    <li t-foreach="learning_resources" t-as="resource" class="mb-2">
                        <a t-att-href="resource.website_url"><span t-field="resource.name"/></a>
                    </li>
                </ul>
            </aside>
            <aside class="mt-4 facodi-open-callout" aria-label="Discuss this lesson with the FACODI community">
                <strong>Discuss this lesson</strong>
                <p class="text-muted small mb-2">Ask a question or share what you learned without losing the lesson context.</p>
                <div class="d-flex flex-wrap gap-2">
                    <a t-att-href="'/community/new?kind=question&amp;slide_id=%s' % slide.id" data-facodi-forum-question-cta="1" class="btn btn-primary btn-sm">Ask a question</a>
                    <a t-att-href="'/community/new?kind=share&amp;slide_id=%s' % slide.id" data-facodi-forum-share-cta="1" class="btn btn-outline-primary btn-sm">Share a note</a>
                </div>
            </aside>
        </xpath>
    </template>

    <template id="course_live_stats" inherit_id="website_slides.course_main" name="Live course statistics">
        <xpath expr="//div[@id='home']" position="inside">
            <t t-set="facodi_course_stats" t-value="channel._facodi_public_course_stats(website)"/>
            <section class="mt-4 mb-4 facodi-course-live-stats" data-facodi-course-live-stats="1" aria-label="Live course snapshot">
                <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
                    <div>
                        <p class="facodi-kicker mb-1">Live course snapshot</p>
                        <h2 class="h4 mb-0">What is available right now</h2>
                    </div>
                    <span class="small text-muted">Calculated from published Odoo content</span>
                </div>
                <div class="row g-3">
                    <div class="col-6 col-lg-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <strong class="display-6 d-block" t-esc="facodi_course_stats['resources']"/>
                                <span class="small text-muted">published resources</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <strong class="display-6 d-block" t-esc="facodi_course_stats['formats']"/>
                                <span class="small text-muted">content formats</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <strong class="display-6 d-block" t-esc="facodi_course_stats['curriculum_links']"/>
                                <span class="small text-muted">reviewed curriculum links</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <strong class="display-6 d-block" t-esc="facodi_course_stats['views']"/>
                                <span class="small text-muted">resource views</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div t-if="facodi_course_stats['format_rows']" class="d-flex flex-wrap gap-2 mt-3" aria-label="Published resources by format">
                    <span t-foreach="facodi_course_stats['format_rows']"
                          t-as="format_row"
                          class="badge rounded-pill text-bg-light border">
                        <t t-esc="format_row['label']"/> · <t t-esc="format_row['count']"/>
                    </span>
                </div>
            </section>
        </xpath>
    </template>

    <template id="course_contribution_cta" inherit_id="website_slides.course_main" name="Course contribution CTA">
        <xpath expr="//div[@id='home']" position="inside">
            <section class="mt-5 facodi-open-callout" aria-label="Contribute to FACODI">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <strong>Contribute to FACODI</strong>
                    <div class="d-flex flex-wrap gap-2">
                        <a t-att-href="'/community/new?kind=question&amp;course_id=%s' % channel.id" data-facodi-forum-question-cta="1" class="btn btn-primary">Ask the community</a>
                        <a t-att-href="'/community/new?kind=share&amp;course_id=%s' % channel.id" data-facodi-forum-share-cta="1" class="btn btn-outline-primary">Share a note</a>
                        <a t-att-href="'/submissions/new?type=resource&amp;course_id=%s&amp;source=course_resource_cta&amp;section=course' % channel.id" class="btn btn-outline-primary">Suggest a learning resource</a>
                        <a t-att-href="'/contact?course_id=%s&amp;source=course_contact_cta&amp;section=course' % channel.id" class="btn btn-link">Other contribution</a>
                    </div>
                </div>
            </section>
        </xpath>
    </template>

    <template id="approved_course_relations" inherit_id="website_slides.course_main" name="Reviewed related courses">
        <xpath expr="//div[@id='home']" position="inside">
            <t t-set="facodi_related_channels" t-value="channel._facodi_related_channels(website)"/>
            <section t-if="facodi_related_channels" class="mt-5 pt-4 border-top" aria-label="Related courses">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <h2 class="h4 mb-1">Related courses</h2>
                        <p class="text-muted mb-0">Continue exploring reviewed FACODI course connections.</p>
                    </div>
                </div>
                <div class="row g-3">
                    <div t-foreach="facodi_related_channels" t-as="related_channel" class="col-12 col-lg-6">
                        <article class="card h-100">
                            <div class="card-body">
                                <h3 class="h5 card-title mb-2">
                                    <a class="stretched-link text-decoration-none"
                                       t-att-href="'/slides/%s' % slug(related_channel)">
                                        <span t-field="related_channel.name"/>
                                    </a>
                                </h3>
                                <div t-if="related_channel.description_short"
                                     class="card-text text-muted"
                                     t-field="related_channel.description_short"/>
                            </div>
                        </article>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
</odoo>
