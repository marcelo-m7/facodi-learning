<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_slide_slide_form_facodi_learning" model="ir.ui.view">
        <field name="name">slide.slide.form.facodi.learning</field>
        <field name="model">slide.slide</field>
        <field name="inherit_id" ref="website_slides.view_slide_slide_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="facodi_learning" string="FACODI Analysis" groups="website_slides.group_website_slides_officer">
                    <group>
                        <group string="Source">
                            <field name="facodi_transcript" placeholder="Optional transcript for analysis..."/>
                            <button name="action_facodi_request_analysis_ui" type="object" string="Queue Analysis" class="btn-primary"/>
                        </group>
                    </group>
                    <separator string="Analysis Jobs"/>
                    <field name="facodi_analysis_job_ids" readonly="1">
                        <list create="0" delete="0">
                            <field name="create_date"/>
                            <field name="state"/>
                            <field name="provider"/>
                            <field name="attempt_count"/>
                            <field name="completed_at"/>
                            <field name="last_error" optional="hide"/>
                        </list>
                    </field>
                    <separator string="Results"/>
                    <field name="facodi_analysis_result_ids" readonly="1">
                        <list create="0" delete="0">
                            <field name="create_date"/>
                            <field name="provider"/>
                            <field name="model_name"/>
                            <field name="detected_language"/>
                            <field name="suggested_tag_ids" widget="many2many_tags"/>
                        </list>
                    </field>
                    <separator string="Mappings"/>
                    <field name="facodi_source_mapping_ids" readonly="1">
                        <list create="0" delete="0">
                            <field name="target_slide_id"/>
                            <field name="mapping_type"/>
                            <field name="confidence"/>
                            <field name="origin"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
