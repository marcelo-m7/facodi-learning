<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="curriculum_public_index" name="FACODI Roadmaps">
        <t t-call="website.layout">
            <t t-set="additional_title">Roadmaps</t>
            <t t-set="meta_description">Explore verified FACODI learning roadmaps, curricular units, modules and published learning content.</t>
            <div id="wrap" class="oe_structure">
                <section class="container py-5 facodi-curriculum">
                    <div class="row justify-content-center">
                        <div class="col-12 col-xl-10">
                            <p class="text-uppercase small text-muted mb-2">FACODI · Roadmaps</p>
                            <h1 class="display-5 mb-3">Learning roadmaps grounded in verified academic sources</h1>
                            <p class="lead text-muted mb-5">
                                Explore each structured learning journey from curricular unit to module, course and learning content.
                            </p>
                            <div class="d-flex flex-wrap gap-2 mb-5">
                                <a href="/unidades-curriculares" class="btn btn-outline-primary">Explore curricular units</a>
                            </div>
                            <div t-if="not references" class="alert alert-info">
                                There are no published roadmaps yet.
                            </div>
                            <div class="row g-4">
                                <div t-foreach="references" t-as="reference" class="col-12 col-lg-6">
                                    <article class="card h-100 shadow-sm">
                                        <div class="card-body">
                                            <p class="small text-muted mb-2">
                                                <t t-esc="reference.institution"/> · <t t-esc="reference.academic_year"/>
                                            </p>
                                            <h2 class="h4">
                                                <a t-att-href="'/roadmaps/%s' % reference.id" class="text-decoration-none">
                                                    <t t-esc="reference.programme_name"/>
                                                </a>
                                            </h2>
                                            <p t-if="reference.external_programme_code" class="mb-0">
                                                Programme code: <strong t-esc="reference.external_programme_code"/>
                                            </p>
                                        </div>
                                    </article>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="curriculum_public_map" name="FACODI Public Roadmap">
        <t t-call="website.layout">
            <t t-set="additional_title">Roadmaps</t>
            <t t-set="meta_description">Explore published FACODI roadmaps, curricular units, learning modules and approved course coverage.</t>
            <div id="wrap" class="oe_structure">
                <section class="container py-5 facodi-curriculum facodi-curriculum-map">
                    <div class="row justify-content-center">
                        <div class="col-12 col-xl-10">
                            <nav class="small mb-4" aria-label="Breadcrumb">
                                <a href="/roadmaps" class="text-decoration-none">Roadmaps</a>
                                <span class="text-muted mx-1">/</span>
                                <span>Roadmap</span>
                            </nav>
                            <p class="text-uppercase small text-muted mb-2">FACODI · Roadmaps</p>
                            <h1 class="display-5 mb-3">Published learning roadmaps</h1>
                            <p class="lead text-muted mb-5">
                                Follow each published path from curriculum reference to curricular unit, learning module and public FACODI course or content.
                            </p>
                            <div t-if="not curriculum_map" class="alert alert-info" role="status">
                                There are no published roadmaps yet.
                            </div>
                            <section t-foreach="curriculum_map" t-as="path" class="facodi-curriculum-pathway mb-5" t-att-aria-label="path['reference'].programme_name">
                                <header class="facodi-curriculum-pathway__header">
                                    <div>
                                        <p class="text-muted mb-1"><t t-esc="path['reference'].institution"/> · <t t-esc="path['reference'].academic_year"/></p>
                                        <h2 class="h3 mb-0"><a t-att-href="path['reference_url']" class="text-decoration-none"><t t-esc="path['reference'].programme_name"/></a></h2>
                                    </div>
                                    <a t-att-href="path['reference_url']" class="btn btn-outline-primary btn-sm">View path</a>
                                </header>
                                <div class="facodi-curriculum-map__units">
                                    <article t-foreach="path['unit_matrix']" t-as="entry" class="facodi-curriculum-map__unit">
                                        <div class="facodi-curriculum-map__unit-main">
                                            <p class="small text-muted mb-1"><t t-esc="entry['unit'].curricular_year"/>.º year · <t t-esc="('%g' % entry['unit'].credits) if entry['unit'].credits else '—'"/> ECTS</p>
                                            <h3 class="h5 mb-1"><a t-att-href="entry['unit_url']" class="text-decoration-none"><t t-esc="entry['unit'].name"/></a></h3>
                                            <p class="mb-0"><code t-esc="entry['unit'].external_unit_code"/></p>
                                        </div>
                                        <div class="facodi-curriculum-map__unit-learning">
                                            <p class="small fw-semibold mb-2">Modules</p>
                                            <ul t-if="entry['learning']['modules']" class="list-unstyled mb-0">
                                                <li t-foreach="entry['learning']['modules']" t-as="module_row" class="mb-1">
                                                    <a t-att-href="module_row['module_url']" class="text-decoration-none"><t t-esc="module_row['module'].name"/></a>
                                                    <span class="text-muted small"> · <t t-esc="module_row['item_count']"/> items</span>
                                                </li>
                                            </ul>
                                            <p t-else="" class="text-muted small mb-0">No published modules yet.</p>
                                        </div>
                                        <div class="facodi-curriculum-map__unit-coverage">
                                            <p class="small fw-semibold mb-2">Roadmap coverage</p>
                                            <ul t-if="entry['coverage_rows']" class="list-unstyled mb-0">
                                                <li t-foreach="entry['coverage_rows']" t-as="coverage" class="mb-2">
                                                    <a t-att-href="coverage['channel'].website_url" class="text-decoration-none"><t t-esc="coverage['channel'].name"/></a>
                                                    <span t-attf-class="facodi-coverage-badge facodi-coverage-badge--#{coverage['coverage_type']}"><t t-esc="coverage['coverage_label']"/></span>
                                                </li>
                                            </ul>
                                            <p t-else="" class="text-muted small mb-0">No approved public course coverage yet.</p>
                                        </div>
                                    </article>
                                </div>
                            </section>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="curriculum_public_unit_index" name="FACODI Curricular Units">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5 facodi-curriculum">
                    <div class="row justify-content-center">
                        <div class="col-12 col-xl-10">
                            <nav class="small mb-4" aria-label="Breadcrumb">
                                <a href="/roadmaps" class="text-decoration-none">Roadmaps</a>
                                <span class="text-muted mx-1">/</span>
                                <span>Curricular units</span>
                            </nav>
                            <p class="text-uppercase small text-muted mb-2">FACODI · Roadmaps</p>
                            <h1 class="display-5 mb-3">Curricular units</h1>
                            <p class="lead text-muted mb-4">
                                Explore units from validated programmes and their published FACODI editorial coverage.
                            </p>

                            <form action="/unidades-curriculares" method="get" class="row g-3 border rounded p-3 mb-5" aria-label="Filter curricular units">
                                <div class="col-12 col-md-6">
                                    <label for="curriculum-reference" class="form-label">Roadmap</label>
                                    <select id="curriculum-reference" name="reference_id" class="form-select">
                                        <option value="">All roadmaps</option>
                                        <option t-foreach="references" t-as="reference"
                                                t-att-value="reference.id"
                                                t-att-selected="'selected' if selected_reference_id == reference.id else None">
                                            <t t-esc="reference.institution"/> · <t t-esc="reference.programme_name"/> (<t t-esc="reference.academic_year"/>)
                                        </option>
                                    </select>
                                </div>
                                <div class="col-6 col-md-2">
                                    <label for="curriculum-year" class="form-label">Year</label>
                                    <select id="curriculum-year" name="year" class="form-select">
                                        <option value="">All</option>
                                        <option t-foreach="years" t-as="year" t-att-value="year" t-att-selected="'selected' if selected_year == year else None"><t t-esc="year"/></option>
                                    </select>
                                </div>
                                <div class="col-6 col-md-2">
                                    <label for="curriculum-period" class="form-label">Period</label>
                                    <select id="curriculum-period" name="period" class="form-select">
                                        <option value="">All</option>
                                        <option value="semester_1" t-att-selected="'selected' if selected_period == 'semester_1' else None">First semester</option>
                                        <option value="semester_2" t-att-selected="'selected' if selected_period == 'semester_2' else None">Second semester</option>
                                        <option value="annual" t-att-selected="'selected' if selected_period == 'annual' else None">Annual</option>
                                        <option value="other" t-att-selected="'selected' if selected_period == 'other' else None">As stated by the source</option>
                                    </select>
                                </div>
                                <div class="col-6 col-md-2">
                                    <label for="curriculum-credits" class="form-label">ECTS</label>
                                    <select id="curriculum-credits" name="credits" class="form-select">
                                        <option value="">All</option>
                                        <option t-foreach="credits_options" t-as="credit" t-att-value="credit" t-att-selected="'selected' if selected_credits == credit else None"><t t-esc="'%g' % credit"/></option>
                                    </select>
                                </div>
                                <div class="col-12 d-flex gap-2">
                                    <button type="submit" class="btn btn-primary">Apply filters</button>
                                    <a href="/unidades-curriculares" class="btn btn-outline-secondary">Clear</a>
                                </div>
                            </form>

                            <p class="text-muted small mb-3"><t t-esc="len(entries)"/> curricular unit(s) found.</p>
                            <div t-if="not entries" class="alert alert-info">There are no curricular units for the selected filters.</div>
                            <div class="row g-3">
                                <div t-foreach="entries" t-as="entry" class="col-12 col-lg-6">
                                    <article class="card h-100 shadow-sm">
                                        <div class="card-body d-flex flex-column">
                                            <p class="small text-muted mb-2">
                                                <t t-esc="entry['reference'].institution"/> · <t t-esc="entry['reference'].programme_name"/>
                                            </p>
                                            <h2 class="h5"><a t-att-href="entry['unit_url']" class="text-decoration-none"><t t-esc="entry['unit'].name"/></a></h2>
                                            <p class="mb-3"><code t-esc="entry['unit'].external_unit_code"/> · Year <t t-esc="entry['unit'].curricular_year"/> · <t t-esc="('%g' % entry['unit'].credits) if entry['unit'].credits else '—'"/> ECTS</p>
                                            <div class="mt-auto d-flex justify-content-between align-items-center gap-2">
                                                <span t-if="entry['coverage_status'] == 'covered'" class="badge text-bg-success">Covered</span>
                                                <span t-elif="entry['coverage_status'] == 'partial'" class="badge text-bg-warning">Partial</span>
                                                <span t-else="" class="badge text-bg-light">No published coverage</span>
                                                <a t-att-href="entry['unit_url']" class="btn btn-outline-primary btn-sm">View unit</a>
                                            </div>
                                        </div>
                                    </article>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="curriculum_public_detail" name="FACODI Roadmap Detail">
        <t t-call="website.layout">
            <t t-set="additional_title"><t t-esc="reference.programme_name"/> · Roadmap</t>
            <t t-set="meta_description">Explore the FACODI learning roadmap for <t t-esc="reference.programme_name"/>.</t>
            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-12 col-xl-10">
                            <a href="/roadmaps" class="small text-decoration-none">← All roadmaps</a>
                            <p class="text-uppercase small text-muted mt-4 mb-2">
                                <t t-esc="reference.institution"/> · <t t-esc="reference.academic_year"/>
                            </p>
                            <h1 class="display-5 mb-2"><t t-esc="reference.programme_name"/></h1>
                            <p class="lead text-muted mb-3">FACODI learning roadmap</p>
                            <div class="d-flex flex-wrap gap-2 mb-4">
                                <span t-if="reference.external_programme_code" class="badge text-bg-light">
                                    Programme <t t-esc="reference.external_programme_code"/>
                                </span>
                                <span class="badge text-bg-success">Validated reference</span>
                            </div>
                            <div class="alert alert-light border mb-5">
                                <strong>Provenance.</strong>
                                This page reproduces a versioned external reference. FACODI does not award academic credits or replace the institutional source.
                                <a t-if="reference.source_url" t-att-href="reference.source_url" target="_blank" rel="noopener noreferrer">View official source</a>.
                            </div>

                            <section t-foreach="unit_matrix_groups" t-as="group" class="mb-5">
                                <h2 class="h3 mb-3">Year <t t-esc="group[0]"/></h2>
                                <div t-foreach="group[1]" t-as="period_group" class="table-responsive mb-4">
                                    <h3 class="h5 mb-2">
                                        <t t-if="period_group[0] == 'semester_1'">First semester</t>
                                        <t t-elif="period_group[0] == 'semester_2'">Second semester</t>
                                        <t t-elif="period_group[0] == 'annual'">Annual</t>
                                        <t t-else="">As stated by the source</t>
                                    </h3>
                                    <table class="table align-middle">
                                        <thead>
                                            <tr>
                                                <th>Curricular unit</th>
                                                <th class="d-none d-md-table-cell">Code</th>
                                                <th>ECTS</th>
                                                <th>Period</th>
                                                <th class="d-none d-lg-table-cell">Type</th>
                                                <th>Roadmap</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="period_group[1]" t-as="entry">
                                                <t t-set="unit" t-value="entry['unit']"/>
                                                <td>
                                                    <a t-att-href="entry['unit_url']" class="fw-semibold text-decoration-none">
                                                        <t t-esc="unit.name"/>
                                                    </a>
                                                    <div t-if="unit.option_group" class="small text-muted" t-esc="unit.option_group"/>
                                                </td>
                                                <td class="d-none d-md-table-cell"><code t-esc="unit.external_unit_code"/></td>
                                                <td t-esc="('%g' % unit.credits) if unit.credits else '—'"/>
                                                <td class="d-none d-lg-table-cell">
                                                    <t t-if="unit.period == 'semester_1'">First semester</t>
                                                    <t t-elif="unit.period == 'semester_2'">Second semester</t>
                                                    <t t-elif="unit.period == 'annual'">Annual</t>
                                                    <t t-else="">As stated by the source</t>
                                                </td>
                                                <td class="d-none d-lg-table-cell">
                                                    <t t-if="unit.classification == 'mandatory'">Mandatory</t>
                                                    <t t-elif="unit.classification == 'optional'">Optional</t>
                                                    <t t-else="">Not specified</t>
                                                </td>
                                                <td>
                                                    <div t-if="entry['learning']['modules']" class="mb-2">
                                                        <a t-foreach="entry['learning']['modules']"
                                                           t-as="module_row"
                                                           t-att-href="module_row['module_url']"
                                                           class="d-block small text-decoration-none mb-1">
                                                            <t t-esc="module_row['module'].name"/>
                                                            <span class="text-muted"> · <t t-esc="module_row['item_count']"/> items</span>
                                                        </a>
                                                    </div>
                                                    <span t-if="entry['coverage_status'] == 'covered'" class="badge text-bg-success">
                                                        Covered · <t t-esc="entry['published_course_count']"/> course(s)
                                                    </span>
                                                    <span t-elif="entry['coverage_status'] == 'partial'" class="badge text-bg-warning">
                                                        Partial · <t t-esc="entry['published_course_count']"/> course(s)
                                                    </span>
                                                    <span t-else="" class="badge text-bg-light">
                                                        No published coverage
                                                    </span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </section>

                            <section t-if="coverage_links" class="mt-5 pt-4 border-top">
                                <h2 class="h3">Published roadmap coverage</h2>
                                <p class="text-muted">Published courses linked to curricular units through Manager-reviewed relations.</p>
                                <div class="list-group">
                                    <a t-foreach="coverage_links"
                                       t-as="link"
                                       t-att-href="link['channel'].website_url"
                                       class="list-group-item list-group-item-action">
                                        <strong t-esc="link['unit'].name"/>
                                        <span class="text-muted"> — </span>
                                        <span t-esc="link['channel'].name"/>
                                    </a>
                                </div>
                            </section>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="curriculum_public_unit" name="FACODI Roadmap Unit">
        <t t-call="website.layout">
            <t t-set="additional_title"><t t-esc="unit.name"/> · <t t-esc="reference.programme_name"/></t>
            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-12 col-xl-10">
                            <nav class="small mb-4" aria-label="Breadcrumb">
                                <a href="/roadmaps" class="text-decoration-none">Roadmaps</a>
                                <span class="text-muted mx-1">/</span>
                                <a href="/unidades-curriculares" class="text-decoration-none">Curricular units</a>
                                <span class="text-muted mx-1">/</span>
                                <a t-att-href="'/roadmaps/%s' % reference.id" class="text-decoration-none">
                                    <t t-esc="reference.programme_name"/>
                                </a>
                                <span class="text-muted mx-1">/</span>
                                <span t-esc="unit.external_unit_code"/>
                            </nav>

                            <p class="text-uppercase small text-muted mb-2">
                                <t t-esc="reference.institution"/> · <t t-esc="reference.academic_year"/>
                            </p>
                            <h1 class="display-5 mb-2"><t t-esc="unit.name"/></h1>
                            <p class="lead text-muted mb-4">
                                Curricular unit <code t-esc="unit.external_unit_code"/> from the official programme
                                <t t-esc="reference.programme_name"/>.
                            </p>

                            <div class="row g-3 mb-5">
                                <div class="col-6 col-md-3">
                                    <div class="border rounded p-3 h-100">
                                        <div class="small text-muted">ECTS from source</div>
                                        <strong class="fs-4" t-esc="('%g' % unit.credits) if unit.credits else '—'"/>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="border rounded p-3 h-100">
                                        <div class="small text-muted">Curricular year</div>
                                        <strong class="fs-4"><t t-esc="unit.curricular_year"/></strong>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="border rounded p-3 h-100">
                                        <div class="small text-muted">Period</div>
                                        <strong>
                                            <t t-if="unit.period == 'semester_1'">First semester</t>
                                            <t t-elif="unit.period == 'semester_2'">Second semester</t>
                                            <t t-elif="unit.period == 'annual'">Annual</t>
                                            <t t-else="">As stated by the source</t>
                                        </strong>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="border rounded p-3 h-100">
                                        <div class="small text-muted">Classification</div>
                                        <strong>
                                            <t t-if="unit.classification == 'mandatory'">Mandatory</t>
                                            <t t-elif="unit.classification == 'optional'">Optional</t>
                                            <t t-else="">Not specified</t>
                                        </strong>
                                    </div>
                                </div>
                            </div>

                            <div t-if="unit.option_group" class="alert alert-light border mb-4">
                                <strong>Optional group:</strong> <t t-esc="unit.option_group"/>
                            </div>

                            <div class="alert alert-light border mb-5">
                                <strong>Provenance and limits.</strong>
                                ECTS and the curricular structure shown are facts from the external source.
                                FACODI does not grant credits, enrolment, academic equivalence, or replace the institution.
                                <a t-if="reference.source_url"
                                   t-att-href="reference.source_url"
                                   target="_blank"
                                   rel="noopener noreferrer">View official source</a>.
                            </div>

                            <section t-if="learning['modules']" class="mb-5" aria-labelledby="facodi-unit-modules-heading">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                                    <div>
                                        <h2 id="facodi-unit-modules-heading" class="h3 mb-1">Learning pathway</h2>
                                        <p class="text-muted mb-0">Editorial modules with existing FACODI courses and content.</p>
                                    </div>
                                    <span t-if="show_learning_progress" class="badge text-bg-light fs-6">
                                        <t t-esc="'%.0f' % learning['progress']"/>% complete
                                    </span>
                                </div>
                                <a t-if="show_learning_progress and learning['next_item']"
                                   t-att-href="learning['next_item']['url']"
                                   class="btn btn-primary btn-sm mb-3">
                                    Continue: <t t-esc="learning['next_item']['name']"/>
                                </a>
                                <div class="vstack gap-3">
                                    <article t-foreach="learning['modules']" t-as="module_row" class="border rounded p-3">
                                        <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2">
                                            <h3 class="h5 mb-0">
                                                <a t-att-href="module_row['module_url']" class="text-decoration-none"><t t-esc="module_row['module'].name"/></a>
                                            </h3>
                                            <span class="text-muted small"><t t-esc="module_row['item_count']"/> items</span>
                                        </div>
                                        <div t-if="module_row['items']" class="mt-3">
                                            <div t-foreach="module_row['items']" t-as="item" class="d-flex flex-wrap align-items-center justify-content-between gap-2 border-top py-2">
                                                <a t-att-href="item['url']" class="text-decoration-none"><t t-esc="item['name']"/></a>
                                                <span t-if="show_learning_progress" class="text-muted small"><t t-esc="'%.0f' % item['progress']"/>%</span>
                                            </div>
                                        </div>
                                        <p t-else="" class="text-muted mb-0 mt-3">There is no published content in this module yet.</p>
                                    </article>
                                </div>
                            </section>

                            <section class="mb-5" aria-labelledby="facodi-unit-coverage-heading">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                                    <div>
                                        <h2 id="facodi-unit-coverage-heading" class="h3 mb-1">Published FACODI coverage</h2>
                                        <p class="text-muted mb-0">
                                            Only reviewed and approved relations with currently published courses.
                                        </p>
                                    </div>
                                    <span t-if="coverage_status == 'covered'" class="badge text-bg-success fs-6">Covered</span>
                                    <span t-elif="coverage_status == 'partial'" class="badge text-bg-warning fs-6">Partial</span>
                                    <span t-else="" class="badge text-bg-light fs-6">No published coverage</span>
                                </div>

                                <div t-if="coverage_rows" class="row g-3">
                                    <div t-foreach="coverage_rows" t-as="coverage" class="col-12 col-lg-6">
                                        <article class="card h-100 shadow-sm">
                                            <div class="card-body">
                                                <p class="small text-muted mb-2">
                                                    <span t-attf-class="facodi-coverage-badge facodi-coverage-badge--#{coverage['coverage_type']}"
                                                          t-att-aria-label="coverage['coverage_label']">
                                                        <t t-esc="coverage['coverage_label']"/>
                                                    </span>
                                                </p>
                                                <h3 class="h5 mb-3">
                                                    <a t-att-href="coverage['channel'].website_url" class="text-decoration-none">
                                                        <t t-esc="coverage['channel'].name"/>
                                                    </a>
                                                </h3>
                                                <a t-att-href="coverage['channel'].website_url" class="btn btn-outline-primary btn-sm">
                                                    Open course
                                                </a>
                                            </div>
                                        </article>
                                    </div>
                                </div>
                                <div t-else="" class="border rounded p-4 bg-light">
                                    <p class="mb-2"><strong>There is no published course with reviewed coverage for this unit yet.</strong></p>
                                    <p class="text-muted mb-3">
                                        This is a public editorial gap; it does not mean that external material is unavailable or that academic recognition exists.
                                    </p>
                                    <a href="/slides" class="btn btn-outline-primary">Explore FACODI courses</a>
                                </div>
                            </section>

                            <a href="/unidades-curriculares" class="btn btn-link px-0">
                                ← Back to curricular units
                            </a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="curriculum_public_module" name="FACODI Roadmap Module">
        <t t-call="website.layout">
            <t t-set="additional_title"><t t-esc="module_row['module'].name"/></t>
            <div id="wrap" class="oe_structure">
                <section class="container py-5 facodi-curriculum">
                    <div class="row justify-content-center">
                        <div class="col-12 col-xl-8">
                            <nav class="small mb-4" aria-label="Breadcrumb">
                                <a href="/roadmaps" class="text-decoration-none">Roadmaps</a>
                                <span class="text-muted mx-1">/</span>
                                <span t-esc="module_row['module'].name"/>
                            </nav>
                            <h1 class="display-5 mb-2" t-esc="module_row['module'].name"/>
                            <div t-if="module_row['module'].description" class="lead text-muted mb-4" t-field="module_row['module'].description"/>
                            <p t-if="show_learning_progress" class="text-muted mb-4"><t t-esc="'%.0f' % module_row['progress']"/>% complete</p>
                            <a t-if="show_learning_progress and module_row['next_item']"
                               t-att-href="module_row['next_item']['url']"
                               class="btn btn-primary mb-4">
                                Continue: <t t-esc="module_row['next_item']['name']"/>
                            </a>
                            <div t-if="module_row['items']" class="list-group">
                                <a t-foreach="module_row['items']" t-as="item" t-att-href="item['url']" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3">
                                    <span t-esc="item['name']"/>
                                    <span t-if="show_learning_progress" class="text-muted small"><t t-esc="'%.0f' % item['progress']"/>%</span>
                                </a>
                            </div>
                            <p t-else="" class="border rounded p-4 bg-light mb-0">There is no published content in this module yet.</p>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="approved_course_curriculum_links" inherit_id="website_slides.course_main" name="Official curriculum alignment">
        <xpath expr="//div[@id='home']" position="inside">
            <t t-set="facodi_curriculum_links" t-value="channel._facodi_public_curriculum_links(website)"/>
            <section t-if="facodi_curriculum_links" class="mt-5 pt-4 border-top" aria-label="Official curriculum alignment">
                <h2 class="h4 mb-2">Official curriculum alignment</h2>
                <p class="text-muted">Coverage relations reviewed and approved by FACODI curation.</p>
                <ul class="list-unstyled mb-0">
                    <li t-foreach="facodi_curriculum_links" t-as="link" class="mb-2">
                        <a t-att-href="link['unit_url']" class="text-decoration-none">
                            <strong t-esc="link['unit_name']"/>
                            <span class="text-muted"> · </span>
                            <span t-esc="link['programme_name']"/>
                            <span class="text-muted"> (<t t-esc="link['academic_year']"/>)</span>
                        </a>
                        <span t-attf-class="facodi-coverage-badge facodi-coverage-badge--#{link['coverage_type']}"
                              t-att-aria-label="link['coverage_label']">
                            <t t-esc="link['coverage_label']"/>
                        </span>
                    </li>
                </ul>
            </section>
        </xpath>
    </template>
</odoo>
