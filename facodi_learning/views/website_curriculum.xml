<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="curriculum_public_index" name="FACODI Official Curricula">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-12 col-xl-10">
                            <p class="text-uppercase small text-muted mb-2">FACODI · Currículos oficiais</p>
                            <h1 class="display-5 mb-3">Percursos baseados em planos de estudos oficiais</h1>
                            <p class="lead text-muted mb-5">
                                Referências curriculares versionadas e verificadas, usadas para organizar e auditar a cobertura dos cursos FACODI.
                            </p>
                            <a href="/unidades-curriculares" class="btn btn-outline-primary mb-5">Explorar unidades curriculares</a>
                            <div t-if="not references" class="alert alert-info">
                                Ainda não existem currículos validados publicados.
                            </div>
                            <div class="row g-4">
                                <div t-foreach="references" t-as="reference" class="col-12 col-lg-6">
                                    <article class="card h-100 shadow-sm">
                                        <div class="card-body">
                                            <p class="small text-muted mb-2">
                                                <t t-esc="reference.institution"/> · <t t-esc="reference.academic_year"/>
                                            </p>
                                            <h2 class="h4">
                                                <a t-att-href="'/curriculos/%s' % reference.id" class="text-decoration-none">
                                                    <t t-esc="reference.programme_name"/>
                                                </a>
                                            </h2>
                                            <p t-if="reference.external_programme_code" class="mb-0">
                                                Código do programa: <strong t-esc="reference.external_programme_code"/>
                                            </p>
                                        </div>
                                    </article>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="curriculum_public_unit_index" name="FACODI Curricular Units">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5 facodi-curriculum">
                    <div class="row justify-content-center">
                        <div class="col-12 col-xl-10">
                            <nav class="small mb-4" aria-label="Breadcrumb">
                                <a href="/curriculos" class="text-decoration-none">Currículos</a>
                                <span class="text-muted mx-1">/</span>
                                <span>Unidades curriculares</span>
                            </nav>
                            <p class="text-uppercase small text-muted mb-2">FACODI · Currículos oficiais</p>
                            <h1 class="display-5 mb-3">Unidades curriculares</h1>
                            <p class="lead text-muted mb-4">
                                Explore unidades de planos de estudos validados e a respetiva cobertura editorial publicada no FACODI.
                            </p>

                            <form action="/unidades-curriculares" method="get" class="row g-3 border rounded p-3 mb-5" aria-label="Filtrar unidades curriculares">
                                <div class="col-12 col-md-6">
                                    <label for="curriculum-reference" class="form-label">Percurso</label>
                                    <select id="curriculum-reference" name="reference_id" class="form-select">
                                        <option value="">Todos os percursos</option>
                                        <option t-foreach="references" t-as="reference"
                                                t-att-value="reference.id"
                                                t-att-selected="'selected' if selected_reference_id == reference.id else None">
                                            <t t-esc="reference.institution"/> · <t t-esc="reference.programme_name"/> (<t t-esc="reference.academic_year"/>)
                                        </option>
                                    </select>
                                </div>
                                <div class="col-6 col-md-2">
                                    <label for="curriculum-year" class="form-label">Ano</label>
                                    <select id="curriculum-year" name="year" class="form-select">
                                        <option value="">Todos</option>
                                        <option t-foreach="years" t-as="year" t-att-value="year" t-att-selected="'selected' if selected_year == year else None"><t t-esc="year"/>.º</option>
                                    </select>
                                </div>
                                <div class="col-6 col-md-2">
                                    <label for="curriculum-period" class="form-label">Período</label>
                                    <select id="curriculum-period" name="period" class="form-select">
                                        <option value="">Todos</option>
                                        <option value="semester_1" t-att-selected="'selected' if selected_period == 'semester_1' else None">1.º semestre</option>
                                        <option value="semester_2" t-att-selected="'selected' if selected_period == 'semester_2' else None">2.º semestre</option>
                                        <option value="annual" t-att-selected="'selected' if selected_period == 'annual' else None">Anual</option>
                                        <option value="other" t-att-selected="'selected' if selected_period == 'other' else None">Conforme fonte</option>
                                    </select>
                                </div>
                                <div class="col-6 col-md-2">
                                    <label for="curriculum-credits" class="form-label">ECTS</label>
                                    <select id="curriculum-credits" name="credits" class="form-select">
                                        <option value="">Todos</option>
                                        <option t-foreach="credits_options" t-as="credit" t-att-value="credit" t-att-selected="'selected' if selected_credits == credit else None"><t t-esc="'%g' % credit"/></option>
                                    </select>
                                </div>
                                <div class="col-12 d-flex gap-2">
                                    <button type="submit" class="btn btn-primary">Aplicar filtros</button>
                                    <a href="/unidades-curriculares" class="btn btn-outline-secondary">Limpar</a>
                                </div>
                            </form>

                            <p class="text-muted small mb-3"><t t-esc="len(entries)"/> unidade(s) encontrada(s).</p>
                            <div t-if="not entries" class="alert alert-info">Não existem unidades curriculares para os filtros selecionados.</div>
                            <div class="row g-3">
                                <div t-foreach="entries" t-as="entry" class="col-12 col-lg-6">
                                    <article class="card h-100 shadow-sm">
                                        <div class="card-body d-flex flex-column">
                                            <p class="small text-muted mb-2">
                                                <t t-esc="entry['reference'].institution"/> · <t t-esc="entry['reference'].programme_name"/>
                                            </p>
                                            <h2 class="h5"><a t-att-href="entry['unit_url']" class="text-decoration-none"><t t-esc="entry['unit'].name"/></a></h2>
                                            <p class="mb-3"><code t-esc="entry['unit'].external_unit_code"/> · <t t-esc="entry['unit'].curricular_year"/>.º ano · <t t-esc="('%g' % entry['unit'].credits) if entry['unit'].credits else '—'"/> ECTS</p>
                                            <div class="mt-auto d-flex justify-content-between align-items-center gap-2">
                                                <span t-if="entry['coverage_status'] == 'covered'" class="badge text-bg-success">Coberta</span>
                                                <span t-elif="entry['coverage_status'] == 'partial'" class="badge text-bg-warning">Parcial</span>
                                                <span t-else="" class="badge text-bg-light">Sem cobertura publicada</span>
                                                <a t-att-href="entry['unit_url']" class="btn btn-outline-primary btn-sm">Ver UC</a>
                                            </div>
                                        </div>
                                    </article>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="curriculum_public_detail" name="FACODI Official Curriculum Detail">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-12 col-xl-10">
                            <a href="/curriculos" class="small text-decoration-none">← Todos os currículos</a>
                            <p class="text-uppercase small text-muted mt-4 mb-2">
                                <t t-esc="reference.institution"/> · <t t-esc="reference.academic_year"/>
                            </p>
                            <h1 class="display-5 mb-3"><t t-esc="reference.programme_name"/></h1>
                            <div class="d-flex flex-wrap gap-2 mb-4">
                                <span t-if="reference.external_programme_code" class="badge text-bg-light">
                                    Programa <t t-esc="reference.external_programme_code"/>
                                </span>
                                <span class="badge text-bg-success">Referência validada</span>
                            </div>
                            <div class="alert alert-light border mb-5">
                                <strong>Proveniência.</strong>
                                Esta página reproduz uma referência externa versionada. O FACODI não atribui créditos académicos nem substitui a fonte institucional.
                                <a t-if="reference.source_url" t-att-href="reference.source_url" target="_blank" rel="noopener noreferrer">Consultar fonte oficial</a>.
                            </div>

                            <section t-foreach="unit_matrix_groups" t-as="group" class="mb-5">
                                <h2 class="h3 mb-3"><t t-esc="group[0]"/>.º ano</h2>
                                <div t-foreach="group[1]" t-as="period_group" class="table-responsive mb-4">
                                    <h3 class="h5 mb-2">
                                        <t t-if="period_group[0] == 'semester_1'">1.º semestre</t>
                                        <t t-elif="period_group[0] == 'semester_2'">2.º semestre</t>
                                        <t t-elif="period_group[0] == 'annual'">Anual</t>
                                        <t t-else="">Conforme fonte</t>
                                    </h3>
                                    <table class="table align-middle">
                                        <thead>
                                            <tr>
                                                <th>Unidade curricular</th>
                                                <th class="d-none d-md-table-cell">Código</th>
                                                <th>ECTS</th>
                                                <th>Período</th>
                                                <th class="d-none d-lg-table-cell">Tipo</th>
                                                <th class="d-none d-lg-table-cell">Cobertura FACODI</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="period_group[1]" t-as="entry">
                                                <t t-set="unit" t-value="entry['unit']"/>
                                                <td>
                                                    <a t-att-href="entry['unit_url']" class="fw-semibold text-decoration-none">
                                                        <t t-esc="unit.name"/>
                                                    </a>
                                                    <div t-if="unit.option_group" class="small text-muted" t-esc="unit.option_group"/>
                                                </td>
                                                <td class="d-none d-md-table-cell"><code t-esc="unit.external_unit_code"/></td>
                                                <td t-esc="('%g' % unit.credits) if unit.credits else '—'"/>
                                                <td class="d-none d-lg-table-cell">
                                                    <t t-if="unit.period == 'semester_1'">1.º semestre</t>
                                                    <t t-elif="unit.period == 'semester_2'">2.º semestre</t>
                                                    <t t-elif="unit.period == 'annual'">Anual</t>
                                                    <t t-else="">Conforme fonte</t>
                                                </td>
                                                <td class="d-none d-lg-table-cell">
                                                    <t t-if="unit.classification == 'mandatory'">Obrigatória</t>
                                                    <t t-elif="unit.classification == 'optional'">Opção</t>
                                                    <t t-else="">Não especificado</t>
                                                </td>
                                                <td>
                                                    <span t-if="entry['coverage_status'] == 'covered'" class="badge text-bg-success">
                                                        Coberta · <t t-esc="entry['published_course_count']"/> curso(s)
                                                    </span>
                                                    <span t-elif="entry['coverage_status'] == 'partial'" class="badge text-bg-warning">
                                                        Parcial · <t t-esc="entry['published_course_count']"/> curso(s)
                                                    </span>
                                                    <span t-else="" class="badge text-bg-light">
                                                        Sem cobertura publicada
                                                    </span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </section>

                            <section t-if="coverage_links" class="mt-5 pt-4 border-top">
                                <h2 class="h3">Cobertura FACODI validada</h2>
                                <p class="text-muted">Cursos publicados ligados a unidades curriculares através de relações revistas por um gestor.</p>
                                <div class="list-group">
                                    <a t-foreach="coverage_links"
                                       t-as="link"
                                       t-att-href="link['channel'].website_url"
                                       class="list-group-item list-group-item-action">
                                        <strong t-esc="link['unit'].name"/>
                                        <span class="text-muted"> — </span>
                                        <span t-esc="link['channel'].name"/>
                                    </a>
                                </div>
                            </section>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="curriculum_public_unit" name="FACODI Official Curriculum Unit">
        <t t-call="website.layout">
            <t t-set="additional_title"><t t-esc="unit.name"/> · <t t-esc="reference.programme_name"/></t>
            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-12 col-xl-10">
                            <nav class="small mb-4" aria-label="Breadcrumb">
                                <a href="/curriculos" class="text-decoration-none">Currículos</a>
                                <span class="text-muted mx-1">/</span>
                                <a href="/unidades-curriculares" class="text-decoration-none">Unidades curriculares</a>
                                <span class="text-muted mx-1">/</span>
                                <a t-att-href="'/curriculos/%s' % reference.id" class="text-decoration-none">
                                    <t t-esc="reference.programme_name"/>
                                </a>
                                <span class="text-muted mx-1">/</span>
                                <span t-esc="unit.external_unit_code"/>
                            </nav>

                            <p class="text-uppercase small text-muted mb-2">
                                <t t-esc="reference.institution"/> · <t t-esc="reference.academic_year"/>
                            </p>
                            <h1 class="display-5 mb-2"><t t-esc="unit.name"/></h1>
                            <p class="lead text-muted mb-4">
                                Unidade curricular <code t-esc="unit.external_unit_code"/> do plano oficial
                                <t t-esc="reference.programme_name"/>.
                            </p>

                            <div class="row g-3 mb-5">
                                <div class="col-6 col-md-3">
                                    <div class="border rounded p-3 h-100">
                                        <div class="small text-muted">ECTS da fonte</div>
                                        <strong class="fs-4" t-esc="('%g' % unit.credits) if unit.credits else '—'"/>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="border rounded p-3 h-100">
                                        <div class="small text-muted">Ano curricular</div>
                                        <strong class="fs-4"><t t-esc="unit.curricular_year"/>.º</strong>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="border rounded p-3 h-100">
                                        <div class="small text-muted">Período</div>
                                        <strong>
                                            <t t-if="unit.period == 'semester_1'">1.º semestre</t>
                                            <t t-elif="unit.period == 'semester_2'">2.º semestre</t>
                                            <t t-elif="unit.period == 'annual'">Anual</t>
                                            <t t-else="">Conforme fonte</t>
                                        </strong>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="border rounded p-3 h-100">
                                        <div class="small text-muted">Classificação</div>
                                        <strong>
                                            <t t-if="unit.classification == 'mandatory'">Obrigatória</t>
                                            <t t-elif="unit.classification == 'optional'">Opção</t>
                                            <t t-else="">Não especificado</t>
                                        </strong>
                                    </div>
                                </div>
                            </div>

                            <div t-if="unit.option_group" class="alert alert-light border mb-4">
                                <strong>Grupo de opção:</strong> <t t-esc="unit.option_group"/>
                            </div>

                            <div class="alert alert-light border mb-5">
                                <strong>Proveniência e limites.</strong>
                                Os ECTS e a estrutura curricular apresentados são factos da fonte externa.
                                A FACODI não atribui créditos, matrícula, equivalência académica nem substitui a instituição.
                                <a t-if="reference.source_url"
                                   t-att-href="reference.source_url"
                                   target="_blank"
                                   rel="noopener noreferrer">Consultar fonte oficial</a>.
                            </div>

                            <section t-if="learning['modules']" class="mb-5" aria-labelledby="facodi-unit-modules-heading">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                                    <div>
                                        <h2 id="facodi-unit-modules-heading" class="h3 mb-1">Percurso de aprendizagem</h2>
                                        <p class="text-muted mb-0">Módulos editoriais com cursos e conteúdos FACODI existentes.</p>
                                    </div>
                                    <span t-if="show_learning_progress" class="badge text-bg-light fs-6">
                                        <t t-esc="'%.0f' % learning['progress']"/>% concluído
                                    </span>
                                </div>
                                <a t-if="show_learning_progress and learning['next_item']"
                                   t-att-href="learning['next_item']['url']"
                                   class="btn btn-primary btn-sm mb-3">
                                    Continuar: <t t-esc="learning['next_item']['name']"/>
                                </a>
                                <div class="vstack gap-3">
                                    <article t-foreach="learning['modules']" t-as="module_row" class="border rounded p-3">
                                        <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2">
                                            <h3 class="h5 mb-0">
                                                <a t-att-href="module_row['module_url']" class="text-decoration-none"><t t-esc="module_row['module'].name"/></a>
                                            </h3>
                                            <span class="text-muted small"><t t-esc="module_row['item_count']"/> conteúdos</span>
                                        </div>
                                        <div t-if="module_row['items']" class="mt-3">
                                            <div t-foreach="module_row['items']" t-as="item" class="d-flex flex-wrap align-items-center justify-content-between gap-2 border-top py-2">
                                                <a t-att-href="item['url']" class="text-decoration-none"><t t-esc="item['name']"/></a>
                                                <span t-if="show_learning_progress" class="text-muted small"><t t-esc="'%.0f' % item['progress']"/>%</span>
                                            </div>
                                        </div>
                                        <p t-else="" class="text-muted mb-0 mt-3">Ainda não há conteúdos publicados neste módulo.</p>
                                    </article>
                                </div>
                            </section>

                            <section class="mb-5" aria-labelledby="facodi-unit-coverage-heading">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                                    <div>
                                        <h2 id="facodi-unit-coverage-heading" class="h3 mb-1">Cobertura FACODI publicada</h2>
                                        <p class="text-muted mb-0">
                                            Apenas relações revistas e aprovadas com cursos atualmente publicados.
                                        </p>
                                    </div>
                                    <span t-if="coverage_status == 'covered'" class="badge text-bg-success fs-6">Coberta</span>
                                    <span t-elif="coverage_status == 'partial'" class="badge text-bg-warning fs-6">Parcial</span>
                                    <span t-else="" class="badge text-bg-light fs-6">Sem cobertura publicada</span>
                                </div>

                                <div t-if="coverage_rows" class="row g-3">
                                    <div t-foreach="coverage_rows" t-as="coverage" class="col-12 col-lg-6">
                                        <article class="card h-100 shadow-sm">
                                            <div class="card-body">
                                                <p class="small text-muted mb-2" t-esc="coverage['coverage_label']"/>
                                                <h3 class="h5 mb-3">
                                                    <a t-att-href="coverage['channel'].website_url" class="text-decoration-none">
                                                        <t t-esc="coverage['channel'].name"/>
                                                    </a>
                                                </h3>
                                                <a t-att-href="coverage['channel'].website_url" class="btn btn-outline-primary btn-sm">
                                                    Abrir curso
                                                </a>
                                            </div>
                                        </article>
                                    </div>
                                </div>
                                <div t-else="" class="border rounded p-4 bg-light">
                                    <p class="mb-2"><strong>Ainda não existe curso publicado com cobertura revista para esta UC.</strong></p>
                                    <p class="text-muted mb-3">
                                        Isto representa um gap editorial público; não significa inexistência de materiais externos ou reconhecimento académico.
                                    </p>
                                    <a href="/slides" class="btn btn-outline-primary">Explorar cursos FACODI</a>
                                </div>
                            </section>

                            <a href="/unidades-curriculares" class="btn btn-link px-0">
                                ← Voltar às unidades curriculares
                            </a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="curriculum_public_module" name="FACODI Curriculum Module">
        <t t-call="website.layout">
            <t t-set="additional_title"><t t-esc="module_row['module'].name"/></t>
            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-12 col-xl-8">
                            <nav class="small mb-4" aria-label="Breadcrumb">
                                <a href="/unidades-curriculares" class="text-decoration-none">Unidades curriculares</a>
                                <span class="text-muted mx-1">/</span>
                                <span t-esc="module_row['module'].name"/>
                            </nav>
                            <h1 class="display-5 mb-2" t-esc="module_row['module'].name"/>
                            <div t-if="module_row['module'].description" class="lead text-muted mb-4" t-field="module_row['module'].description"/>
                            <p t-if="show_learning_progress" class="text-muted mb-4"><t t-esc="'%.0f' % module_row['progress']"/>% concluído</p>
                            <a t-if="show_learning_progress and module_row['next_item']"
                               t-att-href="module_row['next_item']['url']"
                               class="btn btn-primary mb-4">
                                Continuar: <t t-esc="module_row['next_item']['name']"/>
                            </a>
                            <div t-if="module_row['items']" class="list-group">
                                <a t-foreach="module_row['items']" t-as="item" t-att-href="item['url']" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3">
                                    <span t-esc="item['name']"/>
                                    <span t-if="show_learning_progress" class="text-muted small"><t t-esc="'%.0f' % item['progress']"/>%</span>
                                </a>
                            </div>
                            <p t-else="" class="border rounded p-4 bg-light mb-0">Ainda não há conteúdos publicados neste módulo.</p>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="approved_course_curriculum_links" inherit_id="website_slides.course_main" name="Official curriculum alignment">
        <xpath expr="//div[@id='home']" position="inside">
            <t t-set="facodi_curriculum_links" t-value="channel._facodi_public_curriculum_links(website)"/>
            <section t-if="facodi_curriculum_links" class="mt-5 pt-4 border-top" aria-label="Official curriculum alignment">
                <h2 class="h4 mb-2">Ligação a currículos oficiais</h2>
                <p class="text-muted">Relações de cobertura revistas e aprovadas pela curadoria FACODI.</p>
                <ul class="list-unstyled mb-0">
                    <li t-foreach="facodi_curriculum_links" t-as="link" class="mb-2">
                        <a t-att-href="link['unit_url']" class="text-decoration-none">
                            <strong t-esc="link['unit_name']"/>
                            <span class="text-muted"> · </span>
                            <span t-esc="link['programme_name']"/>
                            <span class="text-muted"> (<t t-esc="link['academic_year']"/>)</span>
                        </a>
                    </li>
                </ul>
            </section>
        </xpath>
    </template>
</odoo>
