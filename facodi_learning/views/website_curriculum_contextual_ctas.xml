<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Resource CTAs are authored contextually in website_curriculum.xml.
         This inheritance file is reserved for additive editorial actions. -->
    <template id="unit_provenance_correction_cta"
              inherit_id="facodi_learning.curriculum_public_unit"
              name="FACODI Contextual Unit Correction CTA">
        <xpath expr="//*[@data-facodi-unit-provenance='1']" position="inside">
            <div class="mt-3">
                <a t-att-href="'/submissions/new?type=correction&amp;unit_id=%s&amp;source=unit_correction_cta&amp;section=provenance' % unit.id"
                   class="btn btn-link btn-sm px-0">Suggest a correction</a>
            </div>
        </xpath>
    </template>

    <template id="roadmap_provenance_correction_cta"
              inherit_id="facodi_learning.curriculum_public_detail"
              name="FACODI Contextual Roadmap Correction CTA">
        <xpath expr="//*[@data-facodi-roadmap-provenance='1']" position="inside">
            <span class="ms-2">
                <a t-att-href="'/submissions/new?type=correction&amp;roadmap_id=%s&amp;source=roadmap_correction_cta&amp;section=provenance' % reference.id"
                   class="small">Suggest a correction</a>
            </span>
        </xpath>
    </template>
</odoo>
