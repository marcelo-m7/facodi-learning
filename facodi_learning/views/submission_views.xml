<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_facodi_submission_search" model="ir.ui.view">
        <field name="name">facodi.learning.submission.search</field>
        <field name="model">facodi.learning.submission</field>
        <field name="arch" type="xml">
            <search string="Resource Submissions">
                <field name="name"/>
                <field name="source_url"/>
                <field name="submitted_by_id"/>
                <field name="language"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="reviewing" string="Reviewing" domain="[('state', '=', 'reviewing')]"/>
                <filter name="accepted" string="Accepted" domain="[('state', '=', 'accepted')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="resolved" string="Resolved" domain="[('state', '=', 'resolved')]"/>
                <filter name="withdrawn" string="Withdrawn" domain="[('state', '=', 'withdrawn')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_language" string="Language" context="{'group_by': 'language'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_facodi_submission_list" model="ir.ui.view">
        <field name="name">facodi.learning.submission.list</field>
        <field name="model">facodi.learning.submission</field>
        <field name="arch" type="xml">
            <list string="Resource Submissions"
                  create="0"
                  decoration-success="state == 'resolved'"
                  decoration-danger="state == 'rejected'"
                  decoration-info="state == 'reviewing'">
                <field name="name"/>
                <field name="source_url" widget="url"/>
                <field name="language" optional="show"/>
                <field name="submitted_by_id" optional="show"/>
                <field name="state"/>
                <field name="source_id"
                       optional="hide"
                       groups="website_slides.group_website_slides_manager"/>
                <field name="processing_state" optional="show"/>
                <field name="create_date"/>
                <field name="reviewed_by_id" optional="hide"/>
                <field name="reviewed_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_facodi_submission_form" model="ir.ui.view">
        <field name="name">facodi.learning.submission.form</field>
        <field name="model">facodi.learning.submission</field>
        <field name="arch" type="xml">
            <form string="Resource Submission" create="0">
                <header>
                    <button name="action_start_review"
                            type="object"
                            string="Start Review"
                            class="btn-primary"
                            invisible="state != 'submitted'"
                            groups="website_slides.group_website_slides_manager"/>
                    <button name="action_accept"
                            type="object"
                            string="Accept for Curation"
                            class="btn-primary"
                            invisible="state not in ('submitted', 'reviewing')"
                            groups="website_slides.group_website_slides_manager"/>
                    <button name="action_reject"
                            type="object"
                            string="Reject"
                            invisible="state not in ('submitted', 'reviewing')"
                            groups="website_slides.group_website_slides_manager"/>
                    <button name="action_resolve"
                            type="object"
                            string="Mark Resolved"
                            class="btn-primary"
                            invisible="state != 'accepted' or (not candidate_id and not source_id)"
                            groups="website_slides.group_website_slides_manager"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="submitted,reviewing,accepted,rejected,resolved,withdrawn"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="state in ('rejected', 'resolved', 'withdrawn')"/>
                            <field name="source_url" widget="url" readonly="state in ('rejected', 'resolved', 'withdrawn')"/>
                            <field name="language" readonly="state in ('rejected', 'resolved', 'withdrawn')"/>
                            <field name="submitted_by_id" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="candidate_id" readonly="state in ('rejected', 'resolved', 'withdrawn')"/>
                            <field name="source_id"
                                   readonly="state in ('rejected', 'resolved', 'withdrawn')"
                                   groups="website_slides.group_website_slides_manager"/>
                            <field name="source_state" readonly="1" invisible="not source_state"/>
                            <field name="slide_id" readonly="1" invisible="not slide_id"/>
                            <field name="processing_state" readonly="1"/>
                            <field name="analysis_job_id" readonly="1" invisible="not analysis_job_id"/>
                            <field name="analysis_result_id" readonly="1" invisible="not analysis_result_id"/>
                            <field name="reviewed_by_id" readonly="1"/>
                            <field name="reviewed_at" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="context" readonly="state in ('rejected', 'resolved', 'withdrawn')"/>
                        <field name="decision_note"
                               placeholder="Internal editorial note; never shown on the public status page."
                               readonly="state in ('resolved', 'withdrawn')"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_facodi_submissions" model="ir.actions.act_window">
        <field name="name">Resource Submissions</field>
        <field name="res_model">facodi.learning.submission</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_facodi_submission_search"/>
    </record>

    <menuitem id="menu_facodi_submissions"
              name="Submissions"
              parent="menu_facodi_learning_root"
              action="action_facodi_submissions"
              groups="website_slides.group_website_slides_officer"
              sequence="1"/>
</odoo>
