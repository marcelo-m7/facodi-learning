<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_facodi_curriculum_module_list" model="ir.ui.view">
        <field name="name">facodi.learning.curriculum.module.list</field>
        <field name="model">facodi.learning.curriculum.module</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="website_published"/>
            </list>
        </field>
    </record>
    <record id="view_facodi_curriculum_module_form" model="ir.ui.view">
        <field name="name">facodi.learning.curriculum.module.form</field>
        <field name="model">facodi.learning.curriculum.module</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="website_published"/>
                    </group>
                    <field name="description"/>
                    <notebook>
                        <page string="Curricular Units">
                            <field name="assignment_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="curriculum_unit_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Learning Items">
                            <field name="item_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="channel_id"/>
                                    <field name="slide_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_facodi_curriculum_modules" model="ir.actions.act_window">
        <field name="name">Curriculum Modules</field>
        <field name="res_model">facodi.learning.curriculum.module</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_facodi_curriculum_modules"
              name="Modules"
              parent="menu_facodi_learning_curriculum_coverage"
              action="action_facodi_curriculum_modules"
              groups="website_slides.group_website_slides_officer"
              sequence="4"/>
</odoo>