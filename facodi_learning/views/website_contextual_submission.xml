<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="contextual_submission_form" name="FACODI Contextual Submission">
        <t t-call="website.layout">
            <t t-set="additional_title">Contribute to FACODI</t>
            <div id="wrap" class="oe_structure">
                <section class="container py-5 facodi-submission-form" data-facodi-submission-form="1">
                    <div class="row g-4 justify-content-center">
                        <div class="col-12 col-xl-8">
                            <p class="text-uppercase small fw-semibold text-muted mb-2">Contribute to FACODI</p>
                            <h1 class="display-6 mb-3">
                                <t t-if="submission_type == 'contact'">Contact the FACODI team</t>
                                <t t-elif="submission_type == 'correction'">Suggest a correction</t>
                                <t t-elif="submission_type == 'question'">Ask a contextual question</t>
                                <t t-else="">Suggest a learning resource</t>
                            </h1>
                            <p class="lead text-muted">
                                The form is pre-filled from the CTA you clicked. FACODI keeps all submissions under human review before any editorial action.
                            </p>

                            <div class="card mb-4 facodi-context-card">
                                <div class="card-body">
                                    <p class="text-uppercase small fw-semibold mb-2">You are contributing in this context</p>
                                    <dl class="row mb-0 small">
                                        <dt t-if="curriculum_unit" class="col-sm-4">Curricular unit</dt>
                                        <dd t-if="curriculum_unit" class="col-sm-8">
                                            <strong><t t-esc="curriculum_unit.name"/></strong>
                                            <span t-if="curriculum_unit.external_unit_code" class="text-muted"> · <t t-esc="curriculum_unit.external_unit_code"/></span>
                                        </dd>
                                        <dt t-if="roadmap" class="col-sm-4">Roadmap</dt>
                                        <dd t-if="roadmap" class="col-sm-8"><t t-esc="roadmap.display_name"/></dd>
                                        <dt t-if="course" class="col-sm-4">Course</dt>
                                        <dd t-if="course" class="col-sm-8"><t t-esc="course.name"/></dd>
                                        <dt t-if="suggested_slide" class="col-sm-4">Learning item</dt>
                                        <dd t-if="suggested_slide" class="col-sm-8"><t t-esc="suggested_slide.name"/></dd>
                                        <dt t-if="source_cta" class="col-sm-4">CTA</dt>
                                        <dd t-if="source_cta" class="col-sm-8"><code t-esc="source_cta"/></dd>
                                        <dt t-if="source_section" class="col-sm-4">Section</dt>
                                        <dd t-if="source_section" class="col-sm-8"><code t-esc="source_section"/></dd>
                                        <dt t-if="not curriculum_unit and not roadmap and not course and not suggested_slide and not source_cta and not source_section" class="col-sm-4">Context</dt>
                                        <dd t-if="not curriculum_unit and not roadmap and not course and not suggested_slide and not source_cta and not source_section" class="col-sm-8">General FACODI contribution</dd>
                                    </dl>
                                </div>
                            </div>

                            <div t-if="errors" class="alert alert-danger" role="alert">
                                <p class="fw-semibold mb-2">Check the information below.</p>
                                <ul class="mb-0">
                                    <li t-foreach="errors" t-as="error"><t t-esc="error"/></li>
                                </ul>
                            </div>

                            <form action="/submissions/new"
                                  method="post"
                                  t-att-data-facodi-resource-submission="'1' if submission_type == 'resource' else None"
                                  data-facodi-submission-form="1"
                                  data-metadata-endpoint="/contribuir/recurso/metadata">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="submission_type" t-att-value="submission_type"/>
                                <input type="hidden" name="source_cta" t-att-value="source_cta"/>
                                <input type="hidden" name="source_section" t-att-value="source_section"/>
                                <input type="hidden" name="source_page_url" t-att-value="source_page_url"/>
                                <input t-if="curriculum_unit" type="hidden" name="curriculum_unit_id" t-att-value="curriculum_unit.id"/>
                                <input t-if="roadmap" type="hidden" name="roadmap_id" t-att-value="roadmap.id"/>
                                <input t-if="course" type="hidden" name="course_id" t-att-value="course.id"/>
                                <input t-if="suggested_slide" type="hidden" name="slide_id" t-att-value="suggested_slide.id"/>

                                <div class="card mb-4 facodi-form-section">
                                    <div class="card-body">
                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                            <h2 class="h5 mb-0">Submission details</h2>
                                            <span t-if="source_cta or source_section" class="badge text-bg-light border">Context pre-filled</span>
                                        </div>
                                        <p t-if="source_cta or curriculum_unit or roadmap or course or suggested_slide" class="small text-muted mt-2 mb-3">
                                            We already added the context from where you clicked. Review it, add the resource itself and tell us why it belongs here.
                                        </p>
                                        <div class="mb-3">
                                            <label class="form-label" for="facodi_submission_name">Title / subject</label>
                                            <input id="facodi_submission_name" name="name" type="text" maxlength="200" class="form-control" t-att-value="form_values.get('name', '')"/>
                                        </div>

                                        <t t-if="submission_type == 'resource'">
                                            <div class="mb-3">
                                                <label class="form-label" for="facodi_submission_url">Public resource URL</label>
                                                <input id="facodi_submission_url" name="source_url" type="url" required="required" maxlength="2048" class="form-control" t-att-value="form_values.get('source_url', '')" placeholder="https://..."/>
                                                <div class="form-text">Use a public HTTP or HTTPS page. Do not submit passwords, private links or credentials.</div>
                                                <button type="button" class="btn btn-sm btn-outline-primary mt-2" data-facodi-discover-button="1">Detect details</button>
                                                <span class="small text-muted ms-2" data-facodi-discovery-status="1" aria-live="polite"></span>
                                                <div class="card mt-3 d-none facodi-metadata-preview"
                                                     data-facodi-metadata-preview="1"
                                                     aria-live="polite">
                                                    <div class="card-body py-3">
                                                        <div class="d-flex gap-3 align-items-start">
                                                            <img class="rounded d-none"
                                                                 data-facodi-metadata-thumbnail="1"
                                                                 alt=""
                                                                 width="144"
                                                                 height="81"
                                                                 loading="lazy"/>
                                                            <div class="min-w-0">
                                                                <div class="small text-uppercase fw-semibold text-muted mb-1">Detected resource</div>
                                                                <div class="fw-semibold" data-facodi-metadata-title="1"></div>
                                                                <div class="small text-muted" data-facodi-metadata-author="1"></div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row g-3">
                                                <div class="col-md-4">
                                                    <label class="form-label" for="facodi_resource_type">Resource type</label>
                                                    <select id="facodi_resource_type" name="resource_type" class="form-select">
                                                        <option value="video" t-att-selected="'selected' if form_values.get('resource_type', 'video') == 'video' else None">Video</option>
                                                        <option value="article" t-att-selected="'selected' if form_values.get('resource_type') == 'article' else None">Article</option>
                                                        <option value="book" t-att-selected="'selected' if form_values.get('resource_type') == 'book' else None">Book</option>
                                                        <option value="tool" t-att-selected="'selected' if form_values.get('resource_type') == 'tool' else None">Tool</option>
                                                        <option value="repository" t-att-selected="'selected' if form_values.get('resource_type') == 'repository' else None">Repository</option>
                                                        <option value="course" t-att-selected="'selected' if form_values.get('resource_type') == 'course' else None">External course</option>
                                                        <option value="other" t-att-selected="'selected' if form_values.get('resource_type') == 'other' else None">Other</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label" for="facodi_submission_language">Language</label>
                                                    <select id="facodi_submission_language" name="language" class="form-select">
                                                        <option value="" t-att-selected="'selected' if not form_values.get('language') else None">Not specified</option>
                                                        <option value="pt" t-att-selected="'selected' if form_values.get('language') == 'pt' else None">Portuguese</option>
                                                        <option value="en" t-att-selected="'selected' if form_values.get('language') == 'en' else None">English</option>
                                                        <option value="es" t-att-selected="'selected' if form_values.get('language') == 'es' else None">Spanish</option>
                                                        <option value="fr" t-att-selected="'selected' if form_values.get('language') == 'fr' else None">French</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label" for="facodi_resource_level">Level</label>
                                                    <select id="facodi_resource_level" name="resource_level" class="form-select">
                                                        <option value="" t-att-selected="'selected' if not form_values.get('resource_level') else None">Not specified</option>
                                                        <option value="introductory" t-att-selected="'selected' if form_values.get('resource_level') == 'introductory' else None">Introductory</option>
                                                        <option value="intermediate" t-att-selected="'selected' if form_values.get('resource_level') == 'intermediate' else None">Intermediate</option>
                                                        <option value="advanced" t-att-selected="'selected' if form_values.get('resource_level') == 'advanced' else None">Advanced</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </t>

                                        <div class="mt-3">
                                            <label class="form-label" for="facodi_submission_context">
                                                <t t-if="submission_type == 'resource'">Why is this useful?</t>
                                                <t t-else="">Message</t>
                                            </label>
                                            <textarea id="facodi_submission_context" name="context" rows="5" maxlength="4000" class="form-control"><t t-esc="form_values.get('context', '')"/></textarea>
                                        </div>
                                    </div>
                                </div>

                                <div class="card mb-4 facodi-form-section">
                                    <div class="card-body">
                                        <h2 class="h5">Follow-up</h2>
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label" for="facodi_contact_name">Name</label>
                                                <input id="facodi_contact_name" name="contact_name" class="form-control" maxlength="120" t-att-value="form_values.get('contact_name', '')"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label" for="facodi_contact_email">Email</label>
                                                <input id="facodi_contact_email" name="contact_email" type="email" class="form-control" maxlength="254" t-att-required="'required' if submission_type != 'resource' else None" t-att-value="form_values.get('contact_email', '')"/>
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label" for="facodi_organization">Organization</label>
                                                <input id="facodi_organization" name="organization" class="form-control" maxlength="160" t-att-value="form_values.get('organization', '')"/>
                                            </div>
                                        </div>
                                        <div class="form-check mt-3">
                                            <input id="facodi_permission_contact" name="permission_to_contact" value="1" type="checkbox" class="form-check-input" t-att-checked="'checked' if form_values.get('permission_to_contact') else None"/>
                                            <label class="form-check-label" for="facodi_permission_contact">FACODI may contact me about this submission.</label>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap gap-2">
                                    <button type="submit" class="btn btn-primary">Submit for review</button>
                                    <a href="/explore" class="btn btn-outline-secondary">Back to Explore</a>
                                </div>
                            </form>
                        </div>
                        <aside class="col-12 col-xl-4">
                            <div class="card facodi-submit-sidebar">
                                <div class="card-body">
                                    <h2 class="h5">What happens next?</h2>
                                    <ol class="mb-0">
                                        <li>FACODI receives the structured submission.</li>
                                        <li>The team reviews relevance, provenance and safety.</li>
                                        <li>Accepted resources may later enter the editorial pipeline.</li>
                                    </ol>
                                </div>
                            </div>
                        </aside>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
