<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="explore_landing" name="Explore FACODI">
        <t t-call="website.layout">
            <t t-set="additional_title">Explore open learning · FACODI</t>
            <t t-set="website_meta_description">Explore FACODI learning areas, public resources, community videos and open courses.</t>
            <div id="wrap" class="oe_structure">
                <section class="facodi-explore-map container py-5" data-facodi-explore-map="1">
                    <header class="facodi-explore-map__hero facodi-sheet facodi-grid-paper mb-5" data-facodi-motion="rise">
                        <div class="facodi-explore-map__copy">
                            <p class="facodi-kicker mb-2" data-facodi-scramble="1" tabindex="0">FACODI · Explore</p>
                            <h1 class="display-4 fw-bold mb-3">Where do you want to go next?</h1>
                            <p class="lead text-muted mb-0">Courses, curricular units, learning roadmaps and open resources — connected instead of isolated.</p>
                        </div>
                        <div class="facodi-explore-map__route" aria-label="Learning route">
                            <span>Question</span><i class="fa fa-arrow-down" aria-hidden="true"></i>
                            <span>Course</span><i class="fa fa-arrow-down" aria-hidden="true"></i>
                            <span>Curricular Unit</span><i class="fa fa-arrow-down" aria-hidden="true"></i>
                            <span>Roadmap</span><i class="fa fa-arrow-down" aria-hidden="true"></i>
                            <span>Community</span>
                        </div>
                    </header>

                    <div class="facodi-explore-map__snapshot mb-4" data-facodi-motion="fade" data-facodi-motion-delay="60" aria-label="FACODI discovery snapshot">
                        <div class="facodi-stat-note facodi-highlight-lime"><strong t-esc="explore_stats['courses']"/><span>courses</span></div>
                        <div class="facodi-stat-note facodi-highlight-cyan"><strong t-esc="explore_stats['resources']"/><span>resources</span></div>
                        <div class="facodi-stat-note facodi-highlight-mint"><strong t-esc="explore_stats['roadmaps']"/><span>roadmaps</span></div>
                        <div class="facodi-stat-note facodi-highlight-orange"><strong t-esc="explore_stats['units']"/><span>curricular units</span></div>
                        <div class="facodi-stat-note facodi-highlight-pink"><strong t-esc="explore_stats['community']"/><span>community drops</span></div>
                    </div>

                    <div class="facodi-explore-card-grid">
                        <a href="/courses" class="facodi-explore-card facodi-sheet text-decoration-none" data-facodi-spotlight="1" data-facodi-motion="rise" data-facodi-motion-delay="0">
                            <div class="facodi-explore-card__icon"><span class="fa fa-graduation-cap" aria-hidden="true"></span></div>
                            <p class="facodi-label">Courses</p>
                            <h2>Learn by course.</h2>
                            <p><t t-esc="explore_stats['courses']"/> public courses across <t t-esc="explore_stats['areas']"/> learning areas.</p>
                            <span class="facodi-explore-card__cta">Explore courses →</span>
                        </a>

                        <a href="/roadmaps" class="facodi-explore-card facodi-sheet text-decoration-none" data-facodi-spotlight="1" data-facodi-motion="rise" data-facodi-motion-delay="60">
                            <div class="facodi-explore-card__icon"><span class="fa fa-map-o" aria-hidden="true"></span></div>
                            <p class="facodi-label">Roadmaps</p>
                            <h2>Follow the academic path.</h2>
                            <p><t t-esc="explore_stats['roadmaps']"/> validated learning roadmaps connect programme structure to open resources.</p>
                            <span class="facodi-explore-card__cta">Follow a roadmap →</span>
                        </a>

                        <a href="/curricular-units" class="facodi-explore-card facodi-sheet text-decoration-none" data-facodi-spotlight="1" data-facodi-motion="rise" data-facodi-motion-delay="120">
                            <div class="facodi-explore-card__icon"><span class="fa fa-book" aria-hidden="true"></span></div>
                            <p class="facodi-label">Curricular Units</p>
                            <h2>Start from the syllabus.</h2>
                            <p><t t-esc="explore_stats['units']"/> published curricular-unit records with academic context and FACODI coverage.</p>
                            <span class="facodi-explore-card__cta">Explore curricular units →</span>
                        </a>

                        <a href="/explore/content" class="facodi-explore-card facodi-sheet text-decoration-none" data-facodi-spotlight="1" data-facodi-motion="rise" data-facodi-motion-delay="180">
                            <div class="facodi-explore-card__icon"><span class="fa fa-folder-open-o" aria-hidden="true"></span></div>
                            <p class="facodi-label">Open resources</p>
                            <h2>Find the useful tab.</h2>
                            <p><t t-esc="explore_stats['resources']"/> public learning resources can be filtered by area, language and format.</p>
                            <span class="facodi-explore-card__cta">Browse resources →</span>
                        </a>

                        <a href="/explore/areas" class="facodi-explore-card facodi-sheet text-decoration-none" data-facodi-spotlight="1" data-facodi-motion="rise" data-facodi-motion-delay="220">
                            <div class="facodi-explore-card__icon"><span class="fa fa-tags" aria-hidden="true"></span></div>
                            <p class="facodi-label">Learning areas</p>
                            <h2>Browse by learning area.</h2>
                            <p><t t-esc="explore_stats['areas']"/> public learning areas organise the catalogue without hiding the courses behind them.</p>
                            <span class="facodi-explore-card__cta">Explore learning areas →</span>
                        </a>

                        <a href="/explore/videos" class="facodi-explore-card facodi-sheet text-decoration-none" data-facodi-spotlight="1" data-facodi-motion="rise" data-facodi-motion-delay="240">
                            <div class="facodi-explore-card__icon"><span class="fa fa-play-circle-o" aria-hidden="true"></span></div>
                            <p class="facodi-label">Community videos</p>
                            <h2>See what the campus shared.</h2>
                            <p><t t-esc="explore_stats['community']"/> public community video drops appear immediately after submission; review status remains visible for transparency.</p>
                            <span class="facodi-explore-card__cta">Browse community videos →</span>
                        </a>

                        <a href="/forum" class="facodi-explore-card facodi-sheet text-decoration-none" data-facodi-spotlight="1" data-facodi-motion="rise" data-facodi-motion-delay="240">
                            <div class="facodi-explore-card__icon"><span class="fa fa-comments-o" aria-hidden="true"></span></div>
                            <p class="facodi-label">Community</p>
                            <h2>Ask. Compare notes. Share.</h2>
                            <p>The community layer turns isolated resources into discussion, explanation and shared study routes.</p>
                            <span class="facodi-explore-card__cta">Join the conversation →</span>
                        </a>

                        <a href="/submissions/new?type=resource&amp;source=explore_map_resource_cta&amp;section=explore" class="facodi-explore-card facodi-explore-card--action facodi-note text-decoration-none" data-facodi-spotlight="1" data-facodi-motion="rise" data-facodi-motion-delay="300">
                            <div class="facodi-explore-card__icon"><span class="fa fa-plus" aria-hidden="true"></span></div>
                            <p class="facodi-label">Contribute</p>
                            <h2>Found something useful?</h2>
                            <p>Put it on the community desk with the current Explore context already attached.</p>
                            <span class="facodi-explore-card__cta">Suggest a resource →</span>
                        </a>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="explore_areas" name="Explore learning areas">
        <t t-call="website.layout">
            <t t-set="additional_title">Learning areas · FACODI</t>
            <t t-set="website_meta_description">Browse FACODI learning areas represented by public open-learning courses.</t>
            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
                        <div>
                            <p class="text-uppercase small fw-semibold text-muted mb-2">Explore</p>
                            <h1 class="h2 mb-1">Learning areas</h1>
                            <p class="text-muted mb-0">Only areas represented by publicly available courses on this website are shown.</p>
                        </div>
                        <a href="/explore" class="btn btn-outline-secondary">Back to Explore</a>
                    </div>

                    <form method="get" action="/explore/areas" class="row g-2 mb-4" role="search">
                        <div class="col-12 col-md-8 col-lg-6">
                            <label for="facodi-area-query" class="form-label">Search areas</label>
                            <input id="facodi-area-query" type="search" name="q" class="form-control" t-att-value="query" placeholder="e.g. Mathematics"/>
                        </div>
                        <div class="col-auto align-self-end">
                            <button type="submit" class="btn btn-primary">Search</button>
                        </div>
                    </form>

                    <div t-if="areas" class="row g-3">
                        <div t-foreach="areas" t-as="area" class="col-12 col-sm-6 col-lg-4">
                            <article class="card h-100" data-facodi-area-card="1">
                                <div class="card-body d-flex flex-column">
                                    <div t-if="area.group_id" class="small text-muted mb-1"><span t-field="area.group_id.name"/></div>
                                    <h2 class="h5 mb-3"><span t-field="area.name"/></h2>
                                    <div class="d-flex flex-wrap gap-2 mt-auto">
                                        <a t-att-href="'/explore/content?area=%s' % area.id" class="btn btn-sm btn-primary">Browse resources</a>
                                        <a t-att-href="'/submissions/new?type=resource&amp;area=%s&amp;source=area_resource_cta&amp;section=explore-areas' % area.id"
                                           class="btn btn-sm btn-outline-primary">Suggest a resource</a>
                                    </div>
                                </div>
                            </article>
                        </div>
                    </div>
                    <div t-else="" class="alert alert-light border">No public learning areas match this search.</div>
                </section>
            </div>
        </t>
    </template>

    <template id="explore_content" name="Explore learning content">
        <t t-call="website.layout">
            <t t-set="additional_title">Open learning resources · FACODI</t>
            <t t-set="website_meta_description">Search FACODI public learning resources by area, language and format.</t>
            <div id="wrap" class="oe_structure">
                <section class="container py-5" data-facodi-explore-workbench="1">
                    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
                        <div>
                            <p class="facodi-kicker mb-2">Explore · discovery desk</p>
                            <h1 class="display-6 fw-bold mb-1">Find your next useful tab.</h1>
                            <p class="text-muted mb-0"><t t-esc="total"/> public resources in this view. Filter hard, wander freely.</p>
                        </div>
                        <a href="/explore" class="btn btn-outline-secondary">Back to Explore</a>
                    </div>

                    <div class="facodi-discovery-stats mb-2" aria-label="Live catalogue snapshot" data-facodi-live-stats="1">
                        <div class="facodi-discovery-stat facodi-highlight-lime">
                            <strong t-esc="discovery_stats['matching_resources']"/>
                            <span>matching resources</span>
                        </div>
                        <div class="facodi-discovery-stat facodi-highlight-mint">
                            <strong t-esc="discovery_stats['courses']"/>
                            <span>courses represented</span>
                        </div>
                        <div class="facodi-discovery-stat facodi-highlight-cyan">
                            <strong t-esc="discovery_stats['views']"/>
                            <span>resource views</span>
                        </div>
                        <div class="facodi-discovery-stat facodi-highlight-orange">
                            <strong t-esc="discovery_stats['catalogue_resources']"/>
                            <span>catalogue resources</span>
                        </div>
                    </div>
                    <p class="small text-muted mb-4">
                        Live from Odoo:
                        <strong t-esc="discovery_stats['areas']"/> areas
                        <span aria-hidden="true"> · </span>
                        <strong t-esc="discovery_stats['languages']"/> languages
                        <span aria-hidden="true"> · </span>
                        <strong t-esc="discovery_stats['formats']"/> formats
                    </p>

                    <form method="get" action="/explore/content" class="card card-body mb-3 facodi-filter-panel" role="search">
                        <div class="row g-3">
                            <div class="col-12 col-lg-4">
                                <label for="facodi-content-query" class="form-label">Search</label>
                                <input id="facodi-content-query" type="search" name="q" class="form-control" t-att-value="query" placeholder="Search title or description"/>
                            </div>
                            <div class="col-12 col-md-4 col-lg-3">
                                <label for="facodi-area-filter" class="form-label">Area</label>
                                <select id="facodi-area-filter" name="area" class="form-select">
                                    <option value="">All areas</option>
                                    <option t-foreach="areas" t-as="area" t-att-value="area.id" t-att-selected="selected_area_id == area.id">
                                        <t t-esc="area.name"/>
                                    </option>
                                </select>
                            </div>
                            <div class="col-12 col-md-4 col-lg-2">
                                <label for="facodi-language-filter" class="form-label">Language</label>
                                <select id="facodi-language-filter" name="language" class="form-select">
                                    <option value="">All languages</option>
                                    <option t-foreach="language_options" t-as="language" t-att-value="language" t-att-selected="selected_language == language">
                                        <t t-esc="language"/>
                                    </option>
                                </select>
                            </div>
                            <div class="col-12 col-md-4 col-lg-2">
                                <label for="facodi-format-filter" class="form-label">Format</label>
                                <select id="facodi-format-filter" name="format" class="form-select">
                                    <option value="">All formats</option>
                                    <option t-foreach="format_options" t-as="format_row" t-att-value="format_row[0]" t-att-selected="selected_format == format_row[0]">
                                        <t t-esc="format_row[1]"/>
                                    </option>
                                </select>
                            </div>
                            <div class="col-12 col-lg-1 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100">Filter</button>
                            </div>
                        </div>
                    </form>

                    <div t-if="active_filters" class="facodi-filter-chips mb-4" aria-label="Active filters">
                        <span class="facodi-filter-chips__label">On your desk:</span>
                        <a t-foreach="active_filters" t-as="filter_row"
                           t-att-href="filter_row['remove_url']"
                           class="facodi-filter-chip"
                           t-att-aria-label="'Remove filter: %s' % filter_row['label']">
                            <span t-esc="filter_row['label']"/>
                            <span class="facodi-filter-chip__remove" aria-hidden="true">×</span>
                        </a>
                        <a href="/explore/content" class="facodi-filter-chip facodi-filter-chip--clear">Clear the desk</a>
                    </div>

                    <div t-if="slides" class="row g-3">
                        <div t-foreach="slides" t-as="slide" class="col-12 col-md-6 col-xl-4">
                            <article class="card h-100 facodi-resource-card" data-facodi-resource-card="1">
                                <div class="facodi-resource-card__tape" aria-hidden="true"></div>
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                                        <span class="facodi-resource-pill" t-esc="slide.slide_category"/>
                                        <span class="facodi-resource-pill facodi-resource-pill--course" t-field="slide.channel_id.name"/>
                                    </div>
                                    <h2 class="h5 card-title"><span t-field="slide.name"/></h2>
                                    <p t-if="slide.description" class="text-muted small flex-grow-1"><t t-esc="slide.description"/></p>
                                    <div class="d-flex align-items-center justify-content-between gap-2 mt-3">
                                        <span class="small fw-semibold">Open the tab →</span>
                                        <span class="fa fa-external-link" aria-hidden="true"></span>
                                    </div>
                                    <a t-att-href="slide.website_url" class="stretched-link" t-att-aria-label="'Open resource: %s' % slide.name"></a>
                                </div>
                            </article>
                        </div>
                    </div>
                    <div t-else="" class="facodi-empty-state" data-facodi-empty-state="1">
                        <span class="facodi-empty-icon fa fa-search" aria-hidden="true"></span>
                        <h2 class="h4">That shelf is empty. The campus isn't.</h2>
                        <p class="text-muted">No public resource matches this exact combination. Clear the desk, browse learning areas or drop a useful resource for the community.</p>
                        <div class="d-flex flex-wrap justify-content-center gap-2">
                            <a href="/explore/content" class="btn btn-primary">Clear the desk</a>
                            <a href="/explore/areas" class="btn btn-outline-primary">Browse areas</a>
                            <a t-att-href="contribution_url" class="btn btn-outline-secondary">Drop a resource</a>
                        </div>
                    </div>

                    <nav t-if="page_count &gt; 1" class="d-flex justify-content-between align-items-center mt-4" aria-label="Content pagination">
                        <a t-if="previous_url" t-att-href="previous_url" class="btn btn-outline-secondary">Previous</a>
                        <span t-else=""></span>
                        <span class="small text-muted">Page <t t-esc="page"/> of <t t-esc="page_count"/></span>
                        <a t-if="next_url" t-att-href="next_url" class="btn btn-outline-secondary">Next</a>
                        <span t-else=""></span>
                    </nav>
                </section>
            </div>
        </t>
    </template>
    <template id="explore_community_videos" name="FACODI Community Videos">
        <t t-call="website.layout">
            <t t-set="additional_title">Community videos · FACODI</t>
            <t t-set="website_meta_description">Browse public YouTube videos shared by the FACODI community and their editorial review status.</t>
            <div id="wrap" class="oe_structure">
                <section class="container py-5" data-facodi-community-videos="1">
                    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
                        <div>
                            <p class="text-uppercase small fw-semibold text-muted mb-2">Community submissions</p>
                            <h1 class="h2 mb-1">Videos shared by the community</h1>
                            <p class="text-muted mb-0"><t t-esc="total"/> public YouTube submissions found.</p>
                        </div>
                        <div class="d-flex gap-2">
                            <a t-att-href="video_contribution_url" class="btn btn-primary">Share a video</a>
                            <a href="/explore" class="btn btn-outline-secondary">Back to Explore</a>
                        </div>
                    </div>

                    <div class="facodi-community-intro mb-4" role="note">
                        <span class="fa fa-users" aria-hidden="true"></span>
                        <div>
                            <strong class="d-block mb-1">Community queue · shared first, curated next</strong>
                            <span>Valid public YouTube submissions appear here immediately after submission, without waiting for editorial approval. FACODI may still review their relevance, accuracy, provenance or publication rights. A listing here is not an endorsement or an approved learning-resource publication.</span>
                        </div>
                    </div>

                    <form method="get" action="/explore/videos" class="card card-body mb-4" role="search">
                        <div class="row g-3 align-items-end">
                            <div class="col-12 col-lg-7">
                                <label for="facodi-community-video-query" class="form-label">Search submitted videos</label>
                                <input id="facodi-community-video-query"
                                       type="search"
                                       name="q"
                                       class="form-control"
                                       t-att-value="query"
                                       placeholder="Search by submitted title"/>
                            </div>
                            <div class="col-12 col-md-6 col-lg-3">
                                <label for="facodi-community-video-language" class="form-label">Language</label>
                                <select id="facodi-community-video-language" name="language" class="form-select">
                                    <option value="">All languages</option>
                                    <option t-foreach="language_options"
                                            t-as="language"
                                            t-att-value="language"
                                            t-att-selected="selected_language == language">
                                        <t t-esc="language"/>
                                    </option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6 col-lg-2">
                                <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
                            </div>
                        </div>
                    </form>

                    <div t-if="videos" class="row g-3">
                        <div t-foreach="videos" t-as="video" class="col-12 col-md-6 col-xl-4">
                            <article class="card h-100" data-facodi-community-video="1">
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                                        <span class="badge text-bg-light border">YouTube</span>
                                        <span t-attf-class="badge #{'text-bg-success' if video['state'] in ('accepted', 'resolved') else 'text-bg-warning'}"
                                              t-esc="video['state_label']"/>
                                        <span t-if="video['language']" class="small text-muted" t-esc="video['language']"/>
                                    </div>
                                    <h2 class="h5 card-title" t-esc="video['name']"/>
                                    <p class="text-muted small flex-grow-1">
                                        Submitted by the community. Contributor identity and private review details are not published.
                                    </p>
                                    <a t-att-href="video['source_url']"
                                       target="_blank"
                                       rel="noopener noreferrer nofollow"
                                       class="btn btn-outline-primary align-self-start">
                                        Watch on YouTube
                                    </a>
                                </div>
                            </article>
                        </div>
                    </div>
                    <div t-else="" class="facodi-empty-state" data-facodi-empty-state="1">
                        <span class="facodi-empty-icon fa fa-film" aria-hidden="true"></span>
                        <h2 class="h4">Nothing on this shelf yet</h2>
                        <p class="text-muted">No community video submissions match these filters. Try another language or search, or add a useful public video.</p>
                        <div class="d-flex flex-wrap justify-content-center gap-2">
                            <a href="/explore/videos" class="btn btn-outline-secondary">Clear filters</a>
                            <a t-att-href="video_contribution_url" class="btn btn-primary">Share a video</a>
                        </div>
                    </div>

                    <nav t-if="page_count &gt; 1"
                         class="d-flex justify-content-between align-items-center mt-4"
                         aria-label="Community video pagination">
                        <a t-if="previous_url" t-att-href="previous_url" class="btn btn-outline-secondary">Previous</a>
                        <span t-else=""></span>
                        <span class="small text-muted">Page <t t-esc="page"/> of <t t-esc="page_count"/></span>
                        <a t-if="next_url" t-att-href="next_url" class="btn btn-outline-secondary">Next</a>
                        <span t-else=""></span>
                    </nav>
                </section>
            </div>
        </t>
    </template>


    <template id="homepage_catalogue_fragment" name="FACODI Homepage Catalogue Fragment">
        <div class="facodi-home-catalogue-fragment" t-att-data-content-type="content_type">
            <t t-if="content_type == 'courses'">
                <div class="row g-3">
                    <div t-foreach="records" t-as="channel" class="col-12 col-md-6 col-lg-4">
                        <a t-att-href="channel.website_url" class="facodi-course-card facodi-home-fragment-card">
                            <div class="facodi-course-art facodi-home-fragment-art">
                                <div class="facodi-course-fallback" aria-hidden="true">
                                    <span class="facodi-course-fallback-brand" t-translation="off">FACODI.</span>
                                    <strong t-esc="(channel.name or '')[:2].upper()"/>
                                    <i class="fa fa-play-circle" aria-hidden="true" t-translation="off"/>
                                </div>
                            </div>
                            <div class="facodi-course-content">
                                <div class="facodi-course-description" t-field="channel.description_short"/>
                                <h3 t-field="channel.name"/>
                                <div class="facodi-card-bottom">
                                    <span>Open course</span>
                                    <i class="fa fa-arrow-right" aria-hidden="true" t-translation="off"/>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </t>
            <t t-elif="content_type == 'roadmaps'">
                <div class="row g-3">
                    <div t-foreach="records" t-as="reference" class="col-12 col-md-6 col-lg-4">
                        <a t-att-href="'/roadmaps/%s' % reference.id" class="facodi-sheet facodi-home-fragment-card facodi-home-roadmap-card">
                            <p class="facodi-label">Roadmap</p>
                            <h3 t-esc="reference.programme_name"/>
                            <p class="mb-2"><t t-esc="reference.institution"/> · <t t-esc="reference.academic_year"/></p>
                            <span class="facodi-text-link">Open roadmap <i class="fa fa-arrow-right" aria-hidden="true" t-translation="off"/></span>
                        </a>
                    </div>
                </div>
                <div t-if="not records" class="facodi-empty-state">
                    <h3>Roadmaps are being prepared</h3>
                    <p>Browse curricular units or open courses while new learning paths are reviewed.</p>
                </div>
            </t>
            <t t-else="">
                <div class="row g-3">
                    <div t-foreach="records" t-as="entry" class="col-12 col-md-6 col-lg-4">
                        <t t-set="unit" t-value="entry['unit']"/>
                        <t t-set="reference" t-value="entry['reference']"/>
                        <a t-att-href="entry['unit_url']" class="facodi-sheet facodi-home-fragment-card facodi-home-unit-card">
                            <p class="facodi-label">Curricular unit</p>
                            <h3 t-field="unit.name"/>
                            <p class="mb-2">
                                <code t-esc="unit.external_unit_code"/>
                                <span aria-hidden="true"> · </span>
                                <t t-esc="unit.curricular_year"/> year
                                <span aria-hidden="true"> · </span>
                                <t t-esc="('%g' % unit.credits) if unit.credits else '—'"/> ECTS
                            </p>
                            <p class="small mb-3" t-esc="reference.programme_name"/>
                            <span class="facodi-text-link">Open unit <i class="fa fa-arrow-right" aria-hidden="true" t-translation="off"/></span>
                        </a>
                    </div>
                </div>
                <div t-if="not records" class="facodi-empty-state">
                    <h3>Curricular units are being prepared</h3>
                    <p>Explore available courses or roadmaps while this catalogue is completed.</p>
                </div>
            </t>
        </div>
    </template>

</odoo>
