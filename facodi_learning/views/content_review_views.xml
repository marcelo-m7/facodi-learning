<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_facodi_content_review_list" model="ir.ui.view">
        <field name="name">facodi.learning.content.review.list</field>
        <field name="model">facodi.learning.content.review</field>
        <field name="arch" type="xml">
            <list>
                <field name="slide_id"/>
                <field name="state"/>
                <field name="origin"/>
                <field name="author"/>
                <field name="rights_mode"/>
                <field name="source_id"/>
                <field name="reviewed_by_id"/>
                <field name="reviewed_at"/>
            </list>
        </field>
    </record>

    <record id="view_facodi_content_review_form" model="ir.ui.view">
        <field name="name">facodi.learning.content.review.form</field>
        <field name="model">facodi.learning.content.review</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group string="Content">
                            <field name="slide_id" readonly="state != 'pending'"/>
                            <field name="source_id" readonly="state != 'pending'"/>
                            <field name="origin" readonly="1"/>
                            <field name="source_url" readonly="state != 'pending'"/>
                        </group>
                        <group string="Evidence">
                            <field name="author" readonly="state != 'pending'"/>
                            <field name="rights_mode" readonly="state != 'pending'"/>
                            <field name="usage_basis" readonly="state != 'pending'"/>
                            <field name="purpose" readonly="state != 'pending'"/>
                        </group>
                    </group>
                    <group string="Decision">
                        <field name="decision_note" readonly="state != 'pending'"/>
                        <field name="reviewed_by_id" readonly="1"/>
                        <field name="reviewed_at" readonly="1"/>
                        <field name="content_hash" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_facodi_content_reviews" model="ir.actions.act_window">
        <field name="name">Publication Reviews</field>
        <field name="res_model">facodi.learning.content.review</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_facodi_content_reviews"
              name="Publication Reviews"
              parent="menu_facodi_learning_analysis"
              action="action_facodi_content_reviews"
              groups="website_slides.group_website_slides_manager"
              sequence="5"/>
</odoo>
