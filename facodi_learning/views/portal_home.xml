<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_facodi" inherit_id="portal.portal_my_home" name="FACODI Portal Home">
        <xpath expr="//div[hasclass('o_portal_my_home')]" position="attributes">
            <attribute name="data-facodi-portal-home">1</attribute>
        </xpath>

        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <section class="facodi-portal-campus mb-4" data-facodi-campus-card="1">
                <div class="facodi-portal-campus__eyebrow">
                    <span>MINHA FACODI</span>
                    <span aria-hidden="true">//</span>
                    <span>OPEN CAMPUS DESK</span>
                </div>

                <div class="facodi-portal-campus__hero">
                    <div>
                        <p class="facodi-kicker mb-2">Your campus // your tabs // your pace</p>
                        <h1 class="facodi-portal-campus__title mb-2">
                            Hey, <t t-esc="user_id.name"/>. Your desk is open.
                        </h1>
                        <p class="text-muted mb-0">
                            Continue learning, check what you shared with the community and jump back into the FACODI campus.
                        </p>
                    </div>
                    <div class="facodi-portal-campus__status facodi-highlight-lime">
                        <span class="fa fa-circle" aria-hidden="true"></span>
                        CAMPUS ACCESS ACTIVE
                    </div>
                </div>

                <div class="facodi-momentum-strip mt-4" aria-label="Learning pulse">
                    <a href="/slides" class="facodi-momentum-card facodi-highlight-lime text-decoration-none">
                        <span class="facodi-momentum-card__value" t-esc="facodi_learning_stats['courses']"/>
                        <span class="facodi-momentum-card__label">courses on your desk</span>
                        <small class="facodi-momentum-card__sub"><t t-esc="facodi_learning_stats['completed_courses']"/> done</small>
                    </a>
                    <a href="/minhas-contribuicoes" class="facodi-momentum-card facodi-highlight-cyan text-decoration-none">
                        <span class="facodi-momentum-card__value" t-esc="facodi_learning_stats['contributions']"/>
                        <span class="facodi-momentum-card__label">community drops</span>
                    </a>
                    <a href="/minhas-contribuicoes" class="facodi-momentum-card facodi-highlight-pink text-decoration-none">
                        <span class="facodi-momentum-card__value" t-esc="facodi_learning_stats['in_review']"/>
                        <span class="facodi-momentum-card__label">on the review desk</span>
                    </a>
                    <a href="/minhas-contribuicoes" class="facodi-momentum-card facodi-highlight-mint text-decoration-none">
                        <span class="facodi-momentum-card__value" t-esc="facodi_learning_stats['accepted']"/>
                        <span class="facodi-momentum-card__label">accepted / routed</span>
                    </a>
                </div>
            </section>

            <section class="facodi-portal-board mb-4" aria-label="FACODI quick actions">
                <a href="/slides" class="facodi-dashboard-action text-decoration-none">
                    <span class="facodi-dashboard-action__icon fa fa-graduation-cap" aria-hidden="true"></span>
                    <div><strong>Keep learning</strong><small>Courses, lessons and your next study stop</small></div>
                </a>
                <a href="/unidades-curriculares" class="facodi-dashboard-action text-decoration-none">
                    <span class="facodi-dashboard-action__icon fa fa-map-o" aria-hidden="true"></span>
                    <div><strong>Academic map</strong><small>Explore UCs and their open-learning coverage</small></div>
                </a>
                <a href="/contribuir/recurso" class="facodi-dashboard-action text-decoration-none">
                    <span class="facodi-dashboard-action__icon fa fa-plus" aria-hidden="true"></span>
                    <div><strong>Drop a resource</strong><small>Put something useful on the community desk</small></div>
                </a>
                <a href="/forum" class="facodi-dashboard-action text-decoration-none">
                    <span class="facodi-dashboard-action__icon fa fa-comments" aria-hidden="true"></span>
                    <div><strong>Community</strong><small>Ask, compare notes and help another learner</small></div>
                </a>
            </section>

            <div class="row g-4 mb-5">
                <div class="col-12 col-xl-7">
                    <div class="d-flex justify-content-between align-items-end gap-3 mb-3">
                        <div>
                            <p class="facodi-kicker mb-1">Pick up where you left off</p>
                            <h2 class="h3 mb-0">Your learning shelf</h2>
                        </div>
                        <a href="/slides" class="btn btn-sm btn-outline-secondary">Browse all</a>
                    </div>
                    <div t-if="facodi_course_rows" class="row g-3">
                        <div t-foreach="facodi_course_rows" t-as="row" class="col-12 col-md-6">
                            <t t-set="course" t-value="row['course']"/>
                            <article t-attf-class="card h-100 o_wslides_course_card facodi-portal-course-card #{'facodi-portal-course-card--done' if row['is_completed'] else ''}">
                                <div class="facodi-resource-card__tape" aria-hidden="true"></div>
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                                        <span class="facodi-resource-pill facodi-resource-pill--course">Course</span>
                                        <span t-if="row['is_completed']" class="facodi-journey-label facodi-journey-label--done">Done ✓</span>
                                        <span t-else="" class="facodi-journey-label facodi-journey-label--continue"><t t-esc="'%.0f' % row['completion']"/>%</span>
                                    </div>
                                    <h3 class="h5 card-title"><span t-field="course.name"/></h3>
                                    <p t-if="course.description_short" class="small text-muted flex-grow-1">
                                        <t t-esc="course.description_short"/>
                                    </p>
                                    <div class="facodi-course-progress mb-3" role="progressbar"
                                         t-att-aria-valuenow="'%.0f' % row['completion']"
                                         aria-valuemin="0" aria-valuemax="100">
                                        <span t-att-style="'width: %.0f%%' % row['completion']"></span>
                                    </div>
                                    <a t-att-href="course.website_url" class="btn btn-sm btn-primary align-self-start mt-auto">
                                        <t t-if="row['is_completed']">Review course</t>
                                        <t t-else="">Continue course</t>
                                    </a>
                                </div>
                            </article>
                        </div>
                    </div>
                    <div t-else="" class="facodi-empty-state" data-facodi-empty-state="1">
                        <span class="facodi-empty-icon fa fa-compass" aria-hidden="true"></span>
                        <h3 class="h4">Your desk is still clean. Nice.</h3>
                        <p class="text-muted">Pick something worth learning and build your first FACODI shelf.</p>
                        <a href="/slides" class="btn btn-primary">Browse courses</a>
                    </div>
                </div>

                <div class="col-12 col-xl-5">
                    <div class="d-flex justify-content-between align-items-end gap-3 mb-3">
                        <div>
                            <p class="facodi-kicker mb-1">Community desk</p>
                            <h2 class="h3 mb-0">Your latest drops</h2>
                        </div>
                        <a href="/minhas-contribuicoes" class="btn btn-sm btn-outline-secondary">View all</a>
                    </div>
                    <div t-if="facodi_submission_rows" class="d-grid gap-2">
                        <a t-foreach="facodi_submission_rows" t-as="row"
                           t-att-href="'/minhas-contribuicoes/%s' % row['submission'].id"
                           class="facodi-dashboard-submission text-decoration-none">
                            <span class="facodi-dashboard-submission__state" t-esc="row['state_label']"/>
                            <strong t-esc="row['submission'].name"/>
                            <small>
                                <t t-esc="row['submission'].language or '—'"/>
                                <span aria-hidden="true"> · </span>
                                <span>open details →</span>
                            </small>
                        </a>
                    </div>
                    <div t-else="" class="facodi-empty-state" data-facodi-empty-state="1">
                        <span class="facodi-empty-icon fa fa-lightbulb-o" aria-hidden="true"></span>
                        <h3 class="h4">Found something worth sharing?</h3>
                        <p class="text-muted">Put it on the community desk and let FACODI take it through review.</p>
                        <a href="/contribuir/recurso" class="btn btn-primary">Drop a resource</a>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-5">
                <div class="col-12 col-xl-7">
                    <section class="facodi-academic-map" data-facodi-academic-map="1">
                        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
                            <div>
                                <p class="facodi-kicker mb-1">Academic map // coverage, not equivalence</p>
                                <h2 class="h3 mb-1">See where FACODI can take you next</h2>
                                <p t-if="facodi_academic_map" class="small text-muted mb-0">
                                    <t t-esc="facodi_academic_map['reference'].programme_name"/>
                                    <span aria-hidden="true"> · </span>
                                    <t t-esc="facodi_academic_map['reference'].academic_year"/>
                                </p>
                            </div>
                            <a t-if="facodi_academic_map"
                               t-att-href="facodi_academic_map['url']"
                               class="btn btn-sm btn-outline-secondary">Open full roadmap</a>
                        </div>

                        <t t-if="facodi_academic_map">
                            <div class="facodi-academic-map__stats mb-3">
                                <div class="facodi-highlight-mint">
                                    <strong t-esc="facodi_academic_map['counts']['covered']"/>
                                    <span>covered</span>
                                </div>
                                <div class="facodi-highlight-orange">
                                    <strong t-esc="facodi_academic_map['counts']['partial']"/>
                                    <span>partial</span>
                                </div>
                                <div class="facodi-highlight-pink">
                                    <strong t-esc="facodi_academic_map['counts']['gap']"/>
                                    <span>open gaps</span>
                                </div>
                            </div>

                            <div class="facodi-academic-map__grid">
                                <a t-foreach="facodi_academic_map['preview']"
                                   t-as="entry"
                                   t-att-href="entry['unit_url']"
                                   t-att-data-facodi-coverage="entry['coverage_status']"
                                   class="facodi-academic-map__unit text-decoration-none">
                                    <div class="d-flex justify-content-between gap-2 align-items-start">
                                        <span class="facodi-academic-map__code" t-esc="entry['unit'].external_unit_code"/>
                                        <span t-if="entry['on_desk']" class="facodi-academic-map__desk">ON YOUR DESK</span>
                                    </div>
                                    <strong t-esc="entry['unit'].name"/>
                                    <small>
                                        <span t-esc="entry['coverage_status']"/>
                                        <span aria-hidden="true"> · </span>
                                        <t t-esc="entry['published_course_count']"/> course<t t-if="entry['published_course_count'] != 1">s</t>
                                    </small>
                                </a>
                            </div>
                        </t>
                        <div t-else="" class="facodi-empty-state" data-facodi-empty-state="1">
                            <span class="facodi-empty-icon fa fa-map-signs" aria-hidden="true"></span>
                            <h3 class="h4">No academic map pinned yet</h3>
                            <p class="text-muted">The campus is still open. Browse the public Roadmaps and pick a path worth exploring.</p>
                            <a href="/roadmaps" class="btn btn-primary">Explore roadmaps</a>
                        </div>
                    </section>
                </div>

                <div class="col-12 col-xl-5">
                    <section class="facodi-campus-pulse" data-facodi-campus-pulse="1">
                        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
                            <div>
                                <p class="facodi-kicker mb-1">Campus pulse</p>
                                <h2 class="h3 mb-0">What people are talking about</h2>
                            </div>
                            <a href="/forum" class="btn btn-sm btn-outline-secondary">Open community</a>
                        </div>

                        <div t-if="facodi_forum_posts" class="d-grid gap-2">
                            <a t-foreach="facodi_forum_posts"
                               t-as="post"
                               t-att-href="post.website_url"
                               class="facodi-campus-pulse__post text-decoration-none">
                                <div class="d-flex justify-content-between gap-2">
                                    <span class="facodi-campus-pulse__tag">FORUM</span>
                                    <small><t t-esc="post.child_count"/> replies</small>
                                </div>
                                <strong t-esc="post.name"/>
                                <small>
                                    <t t-esc="post.vote_count"/> votes
                                    <span aria-hidden="true"> · </span>
                                    <t t-esc="post.forum_id.name"/>
                                </small>
                            </a>
                        </div>
                        <div t-else="" class="facodi-empty-state" data-facodi-empty-state="1">
                            <span class="facodi-empty-icon fa fa-comments-o" aria-hidden="true"></span>
                            <h3 class="h4">Campus is quiet on your side — for now.</h3>
                            <p class="text-muted">Open the Forum, ask something useful or help another learner move forward.</p>
                            <a href="/forum" class="btn btn-primary">Start a conversation</a>
                        </div>
                    </section>
                </div>
            </div>

            <section class="facodi-latest-wins mb-5" data-facodi-latest-wins="1">
                <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
                    <div>
                        <p class="facodi-kicker mb-1">Latest wins</p>
                        <h2 class="h3 mb-0">What you finished lately</h2>
                        <p class="small text-muted mb-0">Pulled from your native Odoo eLearning completion history.</p>
                    </div>
                    <a href="/slides" class="btn btn-sm btn-outline-secondary">Keep moving</a>
                </div>

                <div t-if="facodi_recent_learning_rows" class="facodi-latest-wins__grid">
                    <a t-foreach="facodi_recent_learning_rows" t-as="row"
                       t-att-href="row['slide'].website_url"
                       class="facodi-latest-win text-decoration-none">
                        <span class="facodi-latest-win__check fa fa-check" aria-hidden="true"></span>
                        <div class="min-w-0">
                            <span class="facodi-latest-win__course" t-esc="row['course'].name"/>
                            <strong class="facodi-latest-win__title" t-esc="row['slide'].name"/>
                            <small class="facodi-latest-win__date" t-field="row['completed_at']" t-options='{"widget": "datetime", "format": "medium"}'/>
                        </div>
                        <span class="facodi-latest-win__arrow" aria-hidden="true">↗</span>
                    </a>
                </div>

                <div t-else="" class="facodi-empty-state facodi-empty-state--compact" data-facodi-empty-state="1">
                    <span class="facodi-empty-icon fa fa-check-circle-o" aria-hidden="true"></span>
                    <h3 class="h4">No finished tabs yet. Good place to start.</h3>
                    <p class="text-muted">Complete your first lesson and it will show up here as part of your real learning trail.</p>
                    <a href="/slides" class="btn btn-primary">Find something to finish</a>
                </div>
            </section>

            <div class="facodi-portal-toolbox-heading mb-2">
                <p class="facodi-kicker mb-1">Standard Odoo, FACODI energy</p>
                <h2 class="h3 mb-0">Your FACODI toolbox</h2>
                <p class="small text-muted mb-0">Account, security and any other portal tools enabled for you stay right here.</p>
            </div>
        </xpath>
    </template>
</odoo>
