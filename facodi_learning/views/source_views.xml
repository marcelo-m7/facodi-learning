<?xml version="1.0" ?>
<odoo>
    <record id="view_learning_source_list" model="ir.ui.view">
        <field name="name">facodi.learning.source.list</field>
        <field name="model">facodi.learning.source</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="provider"/>
                <field name="external_id"/>
                <field name="channel_id"/>
                <field name="slide_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_learning_source_form" model="ir.ui.view">
        <field name="name">facodi.learning.source.form</field>
        <field name="model">facodi.learning.source</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_ingest" type="object" string="Ingest content" class="btn-primary" invisible="state == 'imported'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="state == 'imported'"/>
                        <field name="provider" readonly="id"/>
                        <field name="external_id" readonly="id"/>
                        <field name="channel_id" readonly="id"/>
                        <field name="url" readonly="state == 'imported'"/>
                        <field name="slide_id"/>
                        <field name="imported_at"/>
                        <field name="last_error"/>
                        <field name="metadata" readonly="state == 'imported'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_learning_sources" model="ir.actions.act_window">
        <field name="name">Content Sources</field>
        <field name="res_model">facodi.learning.source</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_learning_sources" name="Sources" parent="menu_facodi_learning_analysis" action="action_learning_sources" groups="website_slides.group_website_slides_manager" sequence="4"/>
</odoo>
