        <!-- Mirror website_slides: Officers read all learning records, but mutate only their own courses. -->
        <record id="rule_facodi_analysis_job_officer_read" model="ir.rule">
            <field name="name">FACODI analysis job: officer read all</field>
            <field name="model_id" ref="model_facodi_learning_analysis_job"/>
            <field name="groups" eval="[(4, ref('website_slides.group_website_slides_officer'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
